{
  "name": "@woowtech/pi-omnigent-plugin",
  "version": "0.3.17",
  "description": "Install Omnigent and connect the engines already present in Pi Web, with fresh-login onboarding and actual conversation verification.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-web",
    "omnigent",
    "claude-code",
    "codex"
  ],
  "bin": {
    "pi-omnigent": "./bin/cli.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "typebox": ">=1.3.27 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typebox": "1.3.27"
  },
  "scripts": {
    "postinstall": "node bin/cli.mjs activate --auto",
    "test": "node --test tests/*.test.mjs && node bin/test-python.mjs",
    "check": "node bin/check.mjs",
    "test:ui": "node --test tests/ui-installer.test.mjs"
  },
  "files": [
    "bin/cli.mjs",
    "src/*.mjs",
    "src/*.ts",
    "src/*.py",
    "extensions/*.ts",
    "README.md",
    "LICENSE",
    "bin/check.mjs",
    "docs/commercial-readiness.md",
    "docs/evidence/*.json",
    "bin/install-ui.mjs",
    "integrations/pi-web/"
  ],
  "overrides": {
    "brace-expansion": "5.0.12",
    "undici": "8.12.2"
  }
}
