{
  "name": "@woowtech/pi-omnigent-plugin",
  "version": "0.1.0",
  "description": "Install Omnigent and connect the engines already present in Pi Web, with fresh-login onboarding and actual conversation verification.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "pi-web", "omnigent", "claude-code", "codex"],
  "bin": { "pi-omnigent": "./bin/cli.mjs" },
  "pi": { "extensions": ["./extensions/index.ts"] },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=1.0.0", "typebox": "*" },
  "devDependencies": { "@earendil-works/pi-coding-agent": "1.0.0", "typebox": "1.3.27" },
  "scripts": {
    "postinstall": "node bin/cli.mjs activate --auto",
    "test": "node --test tests/*.test.mjs && node bin/test-python.mjs",
    "check": "node --check bin/cli.mjs && node --check src/runtime.mjs && node --check src/common.mjs"
  },
  "files": ["bin/cli.mjs", "src/*.mjs", "src/*.ts", "src/*.py", "extensions/*.ts", "README.md", "LICENSE"]
}
