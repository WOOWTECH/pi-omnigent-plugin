+++ b/lib/paseo-plugin.test.mjs
@@ -0,0 +1,412 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import vm from "node:vm";
+import { EventEmitter } from "node:events";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import test from "node:test";
+import ts from "typescript";
+import * as lifecycle from "./paseo-plugin-lifecycle.ts";
+
+const directory = path.dirname(fileURLToPath(import.meta.url));
+const home = "/fixture/home";
+const projectCwd = "/fixture/project";
+const globalPackage = { source: "/fixture/global-paseo", scope: "global", installedPath: "/fixture/global-paseo", packageName: lifecycle.PASEO_PACKAGE_NAME, disabled: false };
+const projectPackage = { ...globalPackage, source: "/fixture/project-paseo", scope: "project", installedPath: "/fixture/project-paseo" };
+
+// Run the actual host modules with isolated SDK, API and session boundaries.
+// No account files, services or model requests are used by these regressions.
+function fixture({ newOnboarding = false, failAt = "", enabled = true, desiredEnabled = enabled, globals = [globalPackage], projects = [], env = {}, trusted = true, existing = [home, projectCwd], files = [], stopFailure = false, owner = globals.find((pkg) => pkg.packageName === lifecycle.PASEO_PACKAGE_NAME) ?? projects[0] } = {}) {
+  const calls = [];
+  const onboardingEvents = [];
+  const onboardingMessages = [];
+  let created = 0;
+  const discoveries = [];
+  const pathChecks = [];
+  const trustChecks = [];
+  const state = { enabled: desiredEnabled, running: desiredEnabled, onboardingSessionId: newOnboarding ? "" : "existing-session" };
+  const records = new Map([["host-registration", { enabled, cwd: projectCwd }]]);
+  const processes = new Map();
+  const signals = [];
+  let nextPid = 200;
+  const packages = [...globals, ...projects];
+  const apis = new Map();
+  const stateDir = path.resolve(env.PI_PASEO_STATE_DIR || "/fixture/agent/pi-paseo");
+  if ((enabled || desiredEnabled) && owner) {
+    const pid = ++nextPid;
+    processes.set(pid, { root: owner.installedPath, identity: `birth-${pid}`, argv: ["/fixture/node", path.join(owner.installedPath, "bin/cli.mjs"), "supervise"] });
+    records.set("supervisor", { pid, identity: `birth-${pid}`, packageRoot: owner.installedPath });
+  }
+  const entry = (pkg) => pkg.disabled ? { source: pkg.source, extensions: [], skills: [], prompts: [], themes: [] } : pkg.source;
+  const stubs = {
+    "node:crypto": { randomUUID: () => "fixture-session" },
+    "node:os": { homedir: () => home },
+    "node:path": path,
+    "node:fs": { statSync(file) {
+      pathChecks.push(file);
+      if (existing.includes(file)) return { isDirectory: () => true };
+      if (files.includes(file)) return { isDirectory: () => false };
+      throw Object.assign(new Error("Fixture path missing"), { code: "ENOENT" });
+    }, existsSync: () => false },
+    "@earendil-works/pi-coding-agent": {
+      getAgentDir: () => "/fixture/agent",
+      SettingsManager: { create(cwd, _agentDir, options) {
+        discoveries.push({ cwd, projectTrusted: options.projectTrusted });
+        return { projectTrusted: options.projectTrusted, getGlobalSettings: () => ({ packages: globals.map(entry) }), getProjectSettings: () => ({ packages: projects.map(entry) }) };
+      } },
+      DefaultPackageManager: class {
+        constructor(options) { this.settings = options.settingsManager; }
+        listConfiguredPackages() {
+          return [...globals.map((pkg) => ({ ...pkg, scope: "user" })), ...(this.settings.projectTrusted ? projects : [])];
+        }
+      },
+    },
+    "./file-access": { allowFileRoot() {} },
+    "./project-trust": { getProjectTrustStatus(cwd) { trustChecks.push(cwd); return { trusted }; } },
+    "./rpc-manager": { async startRpcSession() {
+      assert.ok(newOnboarding, "Existing onboarding must be reused");
+      created++;
+      onboardingEvents.push("created");
+      const entries = [];
+      return { realSessionId: "created-session", session: {
+        async send(command) {
+          onboardingEvents.push(command.type);
+          if (command.type === failAt) throw new Error("fixture-private-failure");
+          return command.type === "get_state" && failAt === "prompt" ? { model: { id: "fixture-model" } } : {};
+        },
+        async shutdown() { onboardingEvents.push("shutdown"); if (failAt === "shutdown") throw new Error("fixture-private-failure"); },
+        inner: { sessionManager: { getEntries: () => entries, appendMessage(message) { onboardingEvents.push("append"); onboardingMessages.push(message.content); entries.push({ type: "message", message }); } } },
+      } };
+    } },
+    "./session-reader": { invalidateSessionListCache() {} },
+    "./paseo-onboarding": {},
+    "./plugin-package-lock": { serializePluginPackageOperation: (task) => task() },
+    "./paseo-plugin-lifecycle": lifecycle,
+    "./paseo-package": {
+      paseoPackageRoot: (root) => root,
+      readPaseoPackageManifest(root) {
+        const name = packages.find((pkg) => pkg.installedPath === root)?.packageName;
+        if (name !== lifecycle.PASEO_PACKAGE_NAME) throw new Error("Fixture package identity unavailable");
+        return { name };
+      },
+      paseoHostApiUrl(pkg, allowDisabled) {
+        assert.equal(pkg.packageName, lifecycle.PASEO_PACKAGE_NAME, "Only Paseo bindings can recover its service");
+        assert.ok(allowDisabled || !pkg.disabled);
+        return `fixture-api:${pkg.source}`;
+      },
+    },
+    "./regular-file": { readRegularFileText(file) {
+      assert.equal(file, path.join(stateDir, "host-registration.json"));
+      return JSON.stringify(records.get("host-registration"));
+    } },
+  };
+  const context = vm.createContext({ process: { env: { PI_CODING_AGENT_DIR: "/fixture/agent", ...env } }, console });
+  function load(name) {
+    const file = path.join(directory, name);
+    const source = fs.readFileSync(file, "utf8");
+    const code = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file + ".ts" }).outputText;
+    const loadedModule = { exports: {} };
+    vm.runInContext(`(function(require, module, exports) { ${code}\n })`, context, { filename: file })((specifier) => {
+      if (apis.has(specifier)) return apis.get(specifier);
+      if (Object.hasOwn(stubs, specifier)) return stubs[specifier];
+      throw new Error(`Unexpected fixture dependency: ${specifier}`);
+    }, loadedModule, loadedModule.exports);
+    return loadedModule.exports;
+  }
+  // Keep the root pause and supervisor migration contracts real; replace only
+  // process, storage and daemon work. These modules are read, never changed.
+  const rootDirectory = path.resolve(process.env.PI_PASEO_PLUGIN_ROOT || path.resolve(directory, "../../.."));
+  const recordName = (file) => path.basename(file, ".json");
+  const runtime = {
+    locations: () => ({ stateDir, agentDir: "/fixture/agent", home }),
+    status: async () => ({ enabled: state.enabled, daemon: { running: state.running } }),
+    deactivate: async () => { state.enabled = false; state.running = false; },
+  };
+  const rootFs = {
+    realpathSync: (file) => file,
+    readFileSync(file) {
+      const match = /^\/proc\/(\d+)\/cmdline$/.exec(file);
+      if (!match || !processes.has(Number(match[1]))) throw Object.assign(new Error("Fixture process missing"), { code: "ENOENT" });
+      return processes.get(Number(match[1])).argv.join("\0") + "\0";
+    },
+    constants: fs.constants, openSync: () => 42, fchmodSync() {}, closeSync() {},
+    existsSync: () => false,
+  };
+  const rootProcess = {
+    platform: "linux", execPath: "/fixture/node", env: {}, cwd: () => projectCwd,
+    kill(pid, signal = "SIGTERM") {
+      if (!processes.has(pid)) throw Object.assign(new Error("Fixture process missing"), { code: "ESRCH" });
+      if (signal !== 0) {
+        if (stopFailure) throw new Error("private-subprocess-output");
+        signals.push(pid);
+        processes.delete(pid);
+      }
+    },
+  };
+  const rootStubs = {
+    "node:fs": rootFs, "node:path": path, "node:url": { fileURLToPath },
+    "@earendil-works/pi-coding-agent": {
+      ...stubs["@earendil-works/pi-coding-agent"],
+      SettingsManager: { create: () => ({ projectTrusted: true, getGlobalSettings: () => ({ packages: globals.map(entry) }), getProjectSettings: () => ({ packages: projects.map(entry) }) }) },
+    },
+    "./runtime.mjs": runtime,
+    "./web-client.mjs": { WEB_BASE_PATH: "/paseo-web", webClientStatus: () => ({ ready: false }) },
+    "./state.mjs": { assertSafePath() {}, processIdentity: (pid) => processes.get(pid)?.identity ?? null },
+    "./onboarding.mjs": {
+      readRecord: (file) => ({ ...records.get(recordName(file)) }),
+      writeRecord: (file, value) => records.set(recordName(file), value),
+      withLock: async (_file, task) => task(),
+      onboardingStatus: () => ({ sessionId: state.onboardingSessionId }),
+      ensureOnboarding: async (create) => {
+        if (!state.onboardingSessionId) {
+          await create("Fixture authorized onboarding prompt", (id) => {
+            onboardingEvents.push("remembered");
+            state.onboardingSessionId = id;
+          });
+        }
+        return { sessionId: state.onboardingSessionId };
+      },
+    },
+    "node:child_process": { spawn(_command, argv) {
+      const pid = ++nextPid;
+      const root = path.dirname(path.dirname(argv[0]));
+      processes.set(pid, { root, identity: `birth-${pid}`, argv: [rootProcess.execPath, ...argv] });
+      state.enabled = true;
+      state.running = true;
+      const child = Object.assign(new EventEmitter(), { pid, unref() {} });
+      queueMicrotask(() => child.emit("spawn"));
+      return child;
+    } },
+  };
+  function loadRoot(name, pkg, dependencies) {
+    const file = path.join(rootDirectory, "src", name);
+    const source = fs.readFileSync(file, "utf8").replaceAll("import.meta.url", JSON.stringify(pathToFileURL(path.join(pkg.installedPath, "src", name)).href));
+    const code = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file + ".ts" }).outputText;
+    const loadedModule = { exports: {} };
+    vm.runInNewContext(`(function(require, module, exports) { ${code}\n })`, { process: rootProcess, console, setTimeout, clearTimeout }, { filename: file })((specifier) => {
+      assert.ok(Object.hasOwn(dependencies, specifier), `Unexpected root dependency: ${specifier}`);
+      return dependencies[specifier];
+    }, loadedModule, loadedModule.exports);
+    return loadedModule.exports;
+  }
+  for (const pkg of packages.filter((entry) => entry.packageName === lifecycle.PASEO_PACKAGE_NAME)) {
+    const supervisor = loadRoot("supervisor.mjs", pkg, rootStubs);
+    const api = loadRoot("host-api.mjs", pkg, { ...rootStubs, "./supervisor.mjs": supervisor });
+    apis.set(`fixture-api:${pkg.source}`, {
+      ...api,
+      async lifecycle(input, hooks) { calls.push({ method: "lifecycle", apiSource: pkg.source, ...input }); return api.lifecycle(input, hooks); },
+      async restore(hooks) { calls.push({ method: "restore", apiSource: pkg.source }); return api.restore(hooks); },
+    });
+  }
+  if (newOnboarding) stubs["./paseo-onboarding"] = load("paseo-onboarding.ts");
+  const plugin = load("paseo-plugin.ts");
+  stubs["./paseo-plugin"] = plugin;
+  return { ...plugin, ...load("plugin-lifecycle.ts"), calls, state, discoveries, pathChecks, trustChecks, records, processes, signals, onboardingEvents, onboardingMessages, createdCount: () => created };
+}
+
+test("failed last-binding removal resumes the previously enabled service and its onboarding", async () => {
+  const unrelated = { ...globalPackage, source: "/fixture/unrelated", installedPath: "/fixture/unrelated", packageName: "unrelated" };
+  const f = fixture({ globals: [unrelated, globalPackage] });
+  const removal = await f.preparePluginPackageRemoval(projectCwd, [unrelated, globalPackage], globalPackage.source, "global");
+  assert.equal(f.state.running, false);
+  // /api/plugins calls recover when removeAndPersist or its settings write fails.
+  await removal.recover();
+  assert.equal(f.state.enabled, true);
+  assert.equal(f.state.running, true);
+  assert.equal(f.state.onboardingSessionId, "existing-session");
+  assert.deepEqual(f.calls.map((call) => call.action), ["remove", "enable"]);
+});
