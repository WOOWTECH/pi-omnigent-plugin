+import assert from "node:assert/strict";
+import test from "node:test";
+import { dispatchPaseoLifecycle, paseoLifecycleTargets } from "./paseo-plugin-lifecycle.ts";
+
+const paseo = { source: "/installed/pi-paseo", scope: "global", packageName: "@woowtech/pi-paseo", installedPath: "/installed/pi-paseo", disabled: false };
+const other = { ...paseo, source: "npm:unrelated", packageName: "unrelated" };
+
+test("successful install and enable trigger only the named Paseo package", () => {
+  assert.deepEqual(paseoLifecycleTargets("install", [], [paseo, other], [paseo, other]), [paseo]);
+  assert.deepEqual(paseoLifecycleTargets("enable", [{ ...paseo, disabled: true }], [paseo], [paseo]), [paseo]);
+  assert.deepEqual(paseoLifecycleTargets("enable", [paseo], [paseo], [paseo]), []);
+  assert.deepEqual(paseoLifecycleTargets("install", [], [{ ...paseo, disabled: true }], [paseo]), []);
+});
+
+test("a failed bulk toggle and a preserved filtered entry never activate or stop Paseo", () => {
+  assert.deepEqual(paseoLifecycleTargets("enable", [{ ...paseo, disabled: true }], [paseo, other], [other]), []);
+  assert.deepEqual(paseoLifecycleTargets("disable", [paseo], [paseo], [paseo]), []);
+  assert.deepEqual(paseoLifecycleTargets("disable", [paseo], [{ ...paseo, disabled: true }], [paseo]), [{ ...paseo, disabled: true }]);
+});
+
+test("remove uses the previous installed identity only after it is actually removed", () => {
+  assert.deepEqual(paseoLifecycleTargets("remove", [paseo], [], [paseo]), [paseo]);
+  assert.deepEqual(paseoLifecycleTargets("remove", [paseo], [paseo], [paseo]), []);
+});
+
+test("lifecycle preserves package operation success when runtime setup fails without leaking output", async () => {
+  const calls = [];
+  const api = { lifecycle: async (input, hooks) => { calls.push(input); await hooks.createOnboarding(); throw new Error("secret-pairing-url-password"); } };
+  const result = await dispatchPaseoLifecycle(api, "install", "/workspace", paseo, [paseo], async () => "unique-session");
+  assert.equal(calls.length, 1);
+  assert.deepEqual(calls[0].packages, [paseo]);
+  assert.match(result.error, /設定頁/);
+  assert.doesNotMatch(JSON.stringify(result), /secret/);
+});
+
+test("lifecycle returns the runtime's existing onboarding id to the plugin response", async () => {
+  let created = 0;
+  const result = await dispatchPaseoLifecycle({ lifecycle: async (_input, hooks) => ({ onboardingSessionId: await hooks.createOnboarding(), scheduled: true }) }, "enable", "/workspace", paseo, [paseo], async () => { created++; return "existing-session"; });
+  assert.equal(created, 1);
+  assert.equal(result.onboardingSessionId, "existing-session");
+  assert.equal(result.scheduled, true);
+});
diff --git a/lib/paseo-plugin-lifecycle.ts b/lib/paseo-plugin-lifecycle.ts
new file mode 100644
index 0000000..da299ba
--- /dev/null
+++ b/lib/paseo-plugin-lifecycle.ts
@@ -0,0 +1,92 @@
+/** A confirmed Pi package operation, after its settings write succeeded. */
+export type PaseoLifecycleAction = "install" | "enable" | "update" | "disable" | "remove";
+export const PASEO_PACKAGE_NAME = "@woowtech/pi-paseo";
+
+export type PaseoPackageRef = {
+  source: string;
+  scope: "global" | "project";
+  packageName?: string;
+  installedPath?: string;
+  disabled: boolean;
+};
+
+export type PaseoLifecycleResult = {
+  onboardingSessionId?: string;
+  scheduled?: boolean;
+  phase?: string;
+  error?: string;
+};
+
+export type PaseoOnboardingRemember = (sessionId: string) => void | Promise<void>;
+export type PaseoOnboardingCreator = (prompt?: string, remember?: PaseoOnboardingRemember) => Promise<string>;
+export type PaseoHostHooks = { createOnboarding: PaseoOnboardingCreator };
+
+export type PaseoHostApi = {
+  lifecycle: (input: {
+    action: PaseoLifecycleAction;
+    cwd: string;
+    source: string;
+    scope: "global" | "project";
+    packages: PaseoPackageRef[];
+  }, hooks: PaseoHostHooks) => Promise<PaseoLifecycleResult>;
+  restore: (hooks: PaseoHostHooks) => Promise<PaseoLifecycleResult>;
+  status: () => Promise<Record<string, unknown>>;
+  diagnostics: () => Promise<Record<string, unknown>>;
+  pair: () => Promise<{ url: string; expiresAt?: string }>;
+  web?: (request: Request) => Response | Promise<Response>;
+  listModels?: (provider: string) => Promise<Record<string, unknown>>;
+  saveConfig: (input: Record<string, unknown>) => Promise<Record<string, unknown>>;
+};
+
+function key(pkg: Pick<PaseoPackageRef, "source" | "scope">): string {
+  return `${pkg.scope}\0${pkg.source}`;
+}
+
+/** Only successfully changed, named Paseo packages receive lifecycle events. */
+export function paseoLifecycleTargets(
+  action: PaseoLifecycleAction,
+  before: readonly PaseoPackageRef[],
+  after: readonly PaseoPackageRef[],
+  successful: readonly Pick<PaseoPackageRef, "source" | "scope">[],
+): PaseoPackageRef[] {
+  const approved = new Set(successful.map(key));
+  const candidates = action === "remove" ? before : after;
+  return candidates.filter((pkg) => {
+    if (pkg.packageName !== PASEO_PACKAGE_NAME || !approved.has(key(pkg))) return false;
+    const previous = before.find((entry) => key(entry) === key(pkg));
+    if (action === "enable") return !pkg.disabled && Boolean(previous?.disabled);
+    if (action === "disable") return pkg.disabled && previous?.disabled === false;
+    if (action === "install" || action === "update") return !pkg.disabled;
+    return !after.some((entry) => key(entry) === key(pkg));
+  });
+}
+
+/** A lifecycle failure must never turn a successful package install into a retry. */
+export async function dispatchPaseoLifecycle(
+  api: PaseoHostApi,
+  action: PaseoLifecycleAction,
+  cwd: string,
+  target: PaseoPackageRef,
+  packages: PaseoPackageRef[],
+  createOnboarding: PaseoOnboardingCreator,
+): Promise<PaseoLifecycleResult> {
+  try {
+    const result = await api.lifecycle({ action, cwd, source: target.source, scope: target.scope, packages }, { createOnboarding });
+    return paseoLifecycleResult(result);
+  } catch {
+    // Runtime exceptions may contain subprocess output or a pairing secret.
+    return { error: "Paseo 初始化尚未完成；請開啟設定頁重試或檢查診斷。" };
+  }
+}
+
+/** Lifecycle receipts must not carry arbitrary runtime output into plugin UI. */
+export function paseoLifecycleResult(input: unknown): PaseoLifecycleResult {
+  if (!input || typeof input !== "object") return {};
+  const value = input as Record<string, unknown>;
+  const result: PaseoLifecycleResult = {};
+  if (typeof value.onboardingSessionId === "string" && /^[a-zA-Z0-9_-]{1,100}$/.test(value.onboardingSessionId)) result.onboardingSessionId = value.onboardingSessionId;
+  if (typeof value.scheduled === "boolean") result.scheduled = value.scheduled;
+  if (typeof value.phase === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(value.phase)) result.phase = value.phase;
+  if (value.error) result.error = "Paseo 初始化尚未完成；請開啟設定頁檢查診斷。";
+  return result;
+}
diff --git a/lib/paseo-plugin.test.mjs b/lib/paseo-plugin.test.mjs
