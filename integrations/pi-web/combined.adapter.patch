+  const [pairUrl, setPairUrl] = useState<string | null>(null);
+  const [checks, setChecks] = useState<Array<{ name: string; status: string; message?: string }>>([]);
+  const [name, setName] = useState("");
+  const [catalogs, setCatalogs] = useState<PaseoModelCatalog[]>([]);
+  const [statusCurrent, setStatusCurrent] = useState(false);
+  const requestVersions = useRef({ workspace: 0, refresh: 0, action: 0, mutation: false, pendingRefresh: 0 });
+  const nameEdited = useRef(false);
+  const lastStatusAt = useRef(0);
