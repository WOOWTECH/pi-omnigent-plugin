+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { setImmediate } from "node:timers/promises";
+import { fileURLToPath } from "node:url";
+import vm from "node:vm";
+import test from "node:test";
+import { NextRequest } from "next/server.js";
+import ts from "typescript";
+
+const host = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");
+const require = createRequire(import.meta.url);
+
+// Execute the real route, proxy, origin checks, path guard, public projections
+// and package serializer. Only package discovery and the installed host API
+// are fixture boundaries; no sessions, accounts or daemon processes are read.
+function fixture(t, options = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-web-paseo-boundary-"));
+  const cwd = path.join(root, "project");
+  fs.mkdirSync(cwd);
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const calls = [];
+  const snapshot = { phase: "running", enabled: true, daemon: { running: true, reachable: true }, ...options.status };
+  const api = {
+    async status() { calls.push("status"); return snapshot; },
+    async diagnostics() { calls.push("diagnostics"); return snapshot; },
+    async listModels(provider) { calls.push(`models:${provider}`); return { models: [{ id: "fixture-model", label: "Fixture model" }] }; },
+    async lifecycle(input) { calls.push(input.action); return { phase: "disabled" }; },
+    async pair() { calls.push("pair"); return { url: "https://app.paseo.sh/pair#fixture-private-value" }; },
+    async saveConfig(config) { calls.push("config"); snapshot.settings = config; return { saved: true }; },
+    ...options.api,
+  };
+  const pkg = { source: path.join(root, "package"), scope: "global", packageName: "@woowtech/pi-paseo", disabled: options.disabled === true };
+  const sandbox = vm.createContext({
+    process: { env: { HOME: root, PI_CODING_AGENT_DIR: path.join(root, "agent"), PI_PASEO_STATE_DIR: path.join(root, "state"), PI_WEB_PASSWORD: "fixture-password" }, platform: process.platform },
+    Buffer, TextDecoder, URL, Response, console,
+  });
+  const modules = new Map();
+  const stubs = {
+    "@earendil-works/pi-coding-agent": {
+      getAgentDir() { calls.push("sdk:getAgentDir"); return path.join(root, "agent"); },
+      SettingsManager: { create() { calls.push("sdk:settings"); throw new Error("Unexpected settings access"); } },
+      DefaultPackageManager: class { constructor() { calls.push("sdk:packages"); } },
+    },
+    "@/lib/project-trust": { getProjectTrustStatus() { calls.push("trust"); return { trusted: true }; } },
+    "@/lib/plugin-updates": { isPluginSourceCheckable: () => false, checkPluginUpdates: async () => { calls.push("updates"); return []; } },
+    "@/lib/plugin-lifecycle": { notifyPluginPackageChange() { calls.push("lifecycle"); }, preparePluginPackageRemoval() { calls.push("removal"); } },
+    "@/lib/paseo-plugin": {
+      configuredPaseoPackages(directory) { calls.push(`discover:${directory}`); return options.missing ? [] : [pkg]; },
+      loadPaseoHostApi: async () => api,
+      createPaseoOnboarding: async (directory, remember, prompt) => { calls.push(`onboarding:${directory}`); await remember?.("fixture-onboarding"); return prompt ? "fixture-onboarding" : "missing-prompt"; },
+    },
+    "@/lib/file-access": {
+      getAllowedFileRoots: async () => new Set([cwd]),
+      isExistingFilePathAllowed: (directory, roots) => load(path.join(host, "lib/path-security.ts")).isExistingPathWithinRoots(directory, roots),
+    },
+    "node:os": { homedir: () => cwd },
+  };
+  function load(file) {
+    if (modules.has(file)) return modules.get(file).exports;
+    const code = ts.transpileModule(fs.readFileSync(file, "utf8"), {
+      compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file,
+    }).outputText;
+    const loaded = { exports: {} };
+    modules.set(file, loaded);
+    vm.runInContext(`(function(require,module,exports){${code}\n})`, sandbox, { filename: file })((specifier) => {
+      if (Object.hasOwn(stubs, specifier)) return stubs[specifier];
+      if (specifier.startsWith("@/")) return load(path.join(host, specifier.slice(2) + ".ts"));
+      if (specifier.startsWith(".")) return load(path.resolve(path.dirname(file), specifier + ".ts"));
+      return require(specifier);
+    }, loaded, loaded.exports);
+    return loaded.exports;
+  }
+  const route = load(path.join(host, options.routeFile ?? "app/api/plugin-paseo/route.ts"));
+  const { proxy } = load(path.join(host, "proxy.ts"));
+  const { createWebSessionToken } = load(path.join(host, "lib/web-auth.ts"));
+  const token = createWebSessionToken("fixture-password");
+  function request(body, { method = body === undefined ? "GET" : "POST", headers = {}, auth = true, search = "", raw, stream } = {}) {
+    return new NextRequest(`http://localhost${options.routeFile ? options.routeFile.replace(/^app/, "").replace(/\/route\.ts$/, "") : "/api/plugin-paseo"}${search}`, {
+      method,
+      headers: { host: "localhost", origin: "http://localhost", "sec-fetch-site": "same-origin", ...(auth ? { cookie: `pi_web_session=${token}` } : {}), ...(body === undefined && raw === undefined && stream === undefined ? {} : { "content-type": "application/json" }), ...headers },
+      ...(method === "GET" ? {} : { body: stream ?? raw ?? JSON.stringify({ cwd, ...body }), ...(stream ? { duplex: "half" } : {}) }),
+    });
+  }
+  async function dispatch(req) {
+    const guarded = proxy(req);
+    return guarded.headers.get("x-middleware-next") === "1" ? route[req.method](req) : guarded;
+  }
+  return { api, snapshot, cwd, root, calls, request, dispatch, route, serialize: load(path.join(host, "lib/plugin-package-lock.ts")).serializePluginPackageOperation };
+}
+
+test("Paseo proxy authenticates requests and rejects CSRF before loading the installed API", async (t) => {
+  const f = fixture(t);
+  for (const req of [f.request(undefined, { auth: false }), f.request({ action: "pair" }, { auth: false })]) {
+    assert.equal((await f.dispatch(req)).status, 401);
+  }
+  const csrf = f.request({ action: "pair" }, { headers: { origin: "https://attacker.invalid", "sec-fetch-site": "cross-site" } });
+  assert.equal((await f.dispatch(csrf)).status, 403);
+  assert.equal((await f.route.POST(csrf)).status, 403, "The handler also enforces origin checks");
+  assert.equal((await f.dispatch(f.request(undefined, { headers: { host: "rebind.invalid", origin: "http://rebind.invalid" } }))).status, 403);
+  assert.deepEqual(f.calls, []);
+  const res = await f.dispatch(f.request(undefined));
+  assert.equal(res.status, 200);
+  assert.equal(res.headers.get("cache-control"), "private, no-store");
+  assert.equal(res.headers.get("referrer-policy"), "no-referrer");
+});
+
+test("managed Web client route requires login and an enabled installed plugin", async (t) => {
+  const f = fixture(t, { routeFile: "app/paseo-web/[[...path]]/route.ts", api: { web: async () => new Response("managed-client") } });
+  assert.equal((await f.dispatch(f.request(undefined, { auth: false }))).status, 307);
+  assert.deepEqual(f.calls, []);
+  const result = await f.dispatch(f.request());
+  assert.equal(result.status, 200);
+  assert.equal(await result.text(), "managed-client");
+  const disabled = fixture(t, { routeFile: "app/paseo-web/[[...path]]/route.ts", disabled: true });
+  assert.equal((await disabled.dispatch(disabled.request())).status, 404);
+  const old = fixture(t, { routeFile: "app/paseo-web/[[...path]]/route.ts" });
+  assert.equal((await old.dispatch(old.request())).status, 503);
+});
+
+test("pairing accepts only the fixed managed client path and keeps it out of status", async (t) => {
+  const f = fixture(t, { api: { pair: async () => ({ url: "/paseo-web/#private-marker" }) } });
+  const response = await f.dispatch(f.request({ action: "pair" }));
