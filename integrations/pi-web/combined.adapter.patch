+import { NextResponse } from "next/server";
+import { readPendingOmnigentOnboarding } from "@/lib/omnigent-onboarding";
+import { isApiRequestAllowed } from "@/lib/request-security";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+export async function GET(request: Request) {
+  const headers = { "Cache-Control": "no-store" };
+  if (!isApiRequestAllowed(request)) return NextResponse.json({ error: { code: "UNTRUSTED_REQUEST" } }, { status: 403, headers });
+  return NextResponse.json(await readPendingOmnigentOnboarding(), { headers });
+}
