+    versions.pendingRefresh = version;
+    try {
+      const next = paseoPublicStatus(await request(cwd));
+      if (workspace !== versions.workspace || version !== versions.refresh) return;
+      lastStatusAt.current = Date.now();
+      setStatus(next);
+      setStatusCurrent(true);
+      setError("");
+      if (!nameEdited.current) setName(next.configuration?.name ?? "");
+    } catch (failure) {
