+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useI18n } from "@/hooks/useI18n";
+import type { OmnigentView } from "@/lib/omnigent-types";
+import { ConfigButton, ConfigDetail, ConfigDetailGrid, ConfigDetailGridRow, ConfigDetailStack, ConfigDetailTitle,
+  ConfigEmptyState, ConfigField, ConfigFooter, ConfigNotice, ConfigPanelShell, ConfigSectionTitle } from "./SettingsUi";
+
+export function OmnigentConfig({ active, onModels }: { active: boolean; onModels: () => void }) {
+  const { t } = useI18n();
+  const [view, setView] = useState<OmnigentView | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [showSetup, setShowSetup] = useState(false);
+  const [confirmDisconnect, setConfirmDisconnect] = useState(false);
+  const [selection, setSelection] = useState({ engine: "", model: "" });
+  const password = useRef<HTMLInputElement>(null);
+  const mounted = useRef(true);
+
+  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
+  useEffect(() => {
+    const input = password.current;
+    if (!active && input) input.value = "";
+    return () => { if (input) input.value = ""; };
+  }, [active, showSetup]);
+
+  const read = useCallback(async () => {
+    try {
+      const response = await fetch("/api/omnigent", { cache: "no-store" });
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error?.code || "OMNIGENT_FAILED");
+      if (mounted.current) { setView(result); setError(null); }
+    } catch { if (mounted.current) setError(t("omnigent.loadFailed")); }
+  }, [t]);
+  useEffect(() => { if (active) void read(); }, [active, read]);
+
+  async function act(action: string, values: Record<string, unknown> = {}) {
+    if (busy) return;
+    setBusy(action); setError(null);
+    try {
+      const response = await fetch("/api/omnigent", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action, ...values }) });
+      const result = await response.json();
+      if (!mounted.current) return;
+      if (!response.ok) { setError(`${t("omnigent.operationFailed")} (${result.error?.code || "OMNIGENT_FAILED"})`); return; }
+      setView(result);
+      if (result.operation?.ok === false) setError(`${t("omnigent.operationFailed")}${result.operation.code ? ` (${result.operation.code})` : ""}`);
+      if (action === "connect" && result.loginConfirmed) setShowSetup(false);
+      if (action === "disconnect") setConfirmDisconnect(false);
+    } catch { if (mounted.current) setError(t("omnigent.operationFailed")); }
+    finally { if (password.current) password.current.value = ""; if (mounted.current) setBusy(null); }
+  }
+
+  const usable = view?.active && !busy;
+  const engine = view?.engines.find(item => item.key === selection.engine);
+  const label = (key: string) => ({ claude: "Claude Code", codex: "Codex", pi: "Pi Agent" }[key] || key);
+  const engineState = (item: NonNullable<OmnigentView["engines"]>[number]) => !item.installed ? t("omnigent.notInstalled")
+    : item.configured === "needs-auth" ? t("omnigent.providerRequired")
+    : !item.models.length ? t("omnigent.modelsRequired")
+    : item.verified && item.ready ? t("omnigent.verified") : t("omnigent.needsVerification");
+
+  return <ConfigPanelShell embedded title="Omnigent" onClose={() => {}}>
+    <ConfigDetail>
+      <ConfigDetailStack className="omnigent-detail">
+        <ConfigDetailTitle>{t("omnigent.connection")}</ConfigDetailTitle>
+        {error && <div role="alert" className="config-add-source-error">{error}</div>}
+        {!view ? <ConfigEmptyState>{t("omnigent.loading")}</ConfigEmptyState> : !view.installed ? <ConfigEmptyState>
+          {t("omnigent.installRequired")} <code>git:github.com/WOOWTECH/pi-omnigent-plugin</code>
+        </ConfigEmptyState> : <>
+          <ConfigNotice>{view.phase === "ready" ? t("omnigent.ready") : view.loginConfirmed && view.host.connected
+            ? t("omnigent.hostConnected") : t("omnigent.setupRequired")}</ConfigNotice>
+          {!view.active && <ConfigNotice>{t("omnigent.disabled")}</ConfigNotice>}
+          <ConfigDetailGrid>
+            <ConfigDetailGridRow label={t("omnigent.server")}>{view.server || "—"}</ConfigDetailGridRow>
+            <ConfigDetailGridRow label={t("omnigent.host")}>{view.host.name || "—"}</ConfigDetailGridRow>
+            <ConfigDetailGridRow label={t("omnigent.status")}>{view.host.connected ? t("omnigent.online") : t("omnigent.offline")}</ConfigDetailGridRow>
+            <ConfigDetailGridRow label={t("omnigent.version")}>{view.version || "—"}</ConfigDetailGridRow>
+          </ConfigDetailGrid>
+          <div className="omnigent-actions">
+            <ConfigButton disabled={!usable} onClick={() => setShowSetup(value => !value)}>{t("omnigent.configure")}</ConfigButton>
+            {view.server && <a className="config-button config-button-secondary config-button-default" href={view.server} target="_blank" rel="noopener noreferrer">{t("omnigent.open")}</a>}
+            {view.onboardingUrl && <a className="config-button config-button-secondary config-button-default" href={view.onboardingUrl}>{t("omnigent.onboarding")}</a>}
+          </div>
+          {showSetup && <form className="omnigent-setup" onSubmit={event => {
+            event.preventDefault();
+            const form = new FormData(event.currentTarget);
+            const values = { server: form.get("server"), username: form.get("username"), password: form.get("password") };
+            if (password.current) password.current.value = "";
+            void act("connect", values);
+          }}>
+            <ConfigField label={t("omnigent.server")}><input className="config-add-source-input" name="server" aria-label={t("omnigent.server")} type="url" placeholder="https://omnigent.example.com" required disabled={!!busy} /></ConfigField>
+            <ConfigField label={t("omnigent.account")}><input className="config-add-source-input" name="username" aria-label={t("omnigent.account")} autoComplete="username" required disabled={!!busy} /></ConfigField>
+            <ConfigField label={t("omnigent.password")}><input ref={password} className="config-add-source-input" name="password" aria-label={t("omnigent.password")} type="password" autoComplete="current-password" required disabled={!!busy} /></ConfigField>
+            <div className="config-detail-description">{t("omnigent.passwordPrivate")}</div>
+            <ConfigButton variant="primary" type="submit" disabled={!usable}>{busy === "connect" ? t("omnigent.working") : t("omnigent.connect")}</ConfigButton>
+          </form>}
+          <ConfigSectionTitle>{t("omnigent.engines")}</ConfigSectionTitle>
+          <div className="omnigent-engines">
+            {view.engines.map(item => <div className="omnigent-engine" key={item.key}>
+              <strong>{label(item.key)}</strong><span>{item.version || "—"}</span><span>{engineState(item)}</span>
+              <small>{t("omnigent.modelCount").replace("{count}", String(item.models.length))}{item.reason ? ` · ${item.reason}` : ""}</small>
+            </div>)}
+          </div>
+          {view.engines.some(item => item.installed && (!item.models.length || item.configured === "needs-auth")) && <ConfigNotice action={<ConfigButton size="small" onClick={onModels}>{t("omnigent.modelSettings")}</ConfigButton>}>
+            {t("omnigent.providerNotice")}<br /><code>claude auth login --claudeai</code><br /><code>codex login --device-auth</code>
+          </ConfigNotice>}
+          <ConfigSectionTitle>{t("omnigent.verifyTitle")}</ConfigSectionTitle>
+          <div className="config-detail-description">{t("omnigent.verifyNotice")}</div>
+          <div className="omnigent-actions">
+            <select aria-label={t("omnigent.engine")} disabled={!usable} value={selection.engine} onChange={event => setSelection({ engine: event.target.value, model: "" })}>
+              <option value="">{t("omnigent.allEngines")}</option>
+              {view.engines.filter(item => item.installed).map(item => <option key={item.key} value={item.key}>{label(item.key)}</option>)}
+            </select>
+            {engine && <select aria-label={t("omnigent.model")} disabled={!usable} value={selection.model} onChange={event => setSelection(value => ({ ...value, model: event.target.value }))}>
+              <option value="">{t("omnigent.currentModel")}</option>
+              {engine.models.map(model => <option key={model.id} value={model.id}>{model.label}</option>)}
+            </select>}
+            <ConfigButton disabled={!usable || !view.loginConfirmed || !view.host.connected} onClick={() => void act("verify", { ...(selection.engine ? { engine: selection.engine } : {}), ...(selection.model ? { model: selection.model } : {}) })}>{t("omnigent.verify")}</ConfigButton>
+          </div>
+          <ConfigButton variant="danger" disabled={!usable || !view.loginConfirmed} onClick={() => setConfirmDisconnect(true)}>{t("omnigent.disconnect")}</ConfigButton>
+          {confirmDisconnect && <ConfigNotice action={<div className="omnigent-actions"><ConfigButton disabled={!!busy} onClick={() => setConfirmDisconnect(false)}>{t("omnigent.cancel")}</ConfigButton><ConfigButton variant="danger" disabled={!usable} onClick={() => void act("disconnect", { confirm: true })}>{t("omnigent.confirm")}</ConfigButton></div>}>{t("omnigent.disconnectNotice")}</ConfigNotice>}
+        </>}
+      </ConfigDetailStack>
+    </ConfigDetail>
+    <ConfigFooter status={busy ? t("omnigent.working") : ""}><ConfigButton disabled={!!busy} onClick={() => void read()}>{t("omnigent.refresh")}</ConfigButton></ConfigFooter>
+  </ConfigPanelShell>;
+}
