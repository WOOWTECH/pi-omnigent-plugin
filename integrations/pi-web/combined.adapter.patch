+const flush = async () => { for(let i=0;i<8;i++) await setImmediate(); };
+const deferred = () => { let resolve;const promise=new Promise(r=>resolve=r);return {promise,resolve}; };
+function fixture(t, responses=[]) {
+  t.mock.timers.enable({apis:['setTimeout']});
+  const browser=new EventTarget(),calls=[],selected=[],store=new Map();
+  Object.assign(browser,{
+    location:{pathname:'/',search:'',hash:''},
+    sessionStorage:{getItem:key=>store.get(key)},localStorage:{getItem:key=>store.get(key)},
+    document:{querySelectorAll:()=>[]},setTimeout,clearTimeout,
+    fetch:async(url,options)=>{ calls.push({url,signal:options.signal});return {ok:true,json:async()=>responses.shift()?.(url) ?? {pending:true,sessionId:null}}; },
+  });
+  const start=()=>startOmnigentAutoOpen({eligible:()=>true,select:session=>selected.push(session.id)},browser);
+  return {browser,calls,selected,store,start};
+}
+const pending=()=>({pending:true,sessionId:'omni'}),catalog=()=>({sessions:[{id:'paseo'},{id:'omni'}]});
+test('late saved ID retries once and selects exact Omnigent once, even if Paseo is first',async t=>{
+  const f=fixture(t,[()=>({pending:true,sessionId:null}),pending,catalog,pending]);f.start();await flush();
+  assert.equal(f.calls.length,1);t.mock.timers.tick(1000);await flush();
+  assert.deepEqual(f.selected,['omni']);t.mock.timers.tick(40000);await flush();assert.equal(f.calls.length,4);
+});
+test('missing saved ID stops after thirty attempts and thirty seconds',async t=>{
+  const f=fixture(t);f.start();await flush();
+  for(let i=0;i<40;i++){t.mock.timers.tick(1000);await flush();}
+  assert.equal(f.calls.length,30);assert.deepEqual(f.selected,[]);assert.equal(f.calls[0].signal.aborted,true);
+});
+test('hung initial response is aborted at the thirty second deadline',async t=>{
+  const wait=deferred(),f=fixture(t,[()=>wait.promise]);f.start();await flush();
+  t.mock.timers.tick(30000);await flush();assert.equal(f.calls[0].signal.aborted,true);
+  wait.resolve(pending());await flush();assert.equal(f.calls.length,1);assert.deepEqual(f.selected,[]);
+});
+for(const event of ['pointerdown','click','keydown','beforeinput','input','paste','compositionstart','drop','wheel','touchstart','popstate','hashchange']){
+  test(`${event} during a delayed response permanently cancels auto-open`,async t=>{
+    const wait=deferred(),f=fixture(t,[()=>wait.promise,catalog,pending]);f.start();await flush();
+    f.browser.dispatchEvent(new Event(event));wait.resolve(pending());await flush();t.mock.timers.tick(40000);await flush();
+    assert.deepEqual(f.selected,[]);assert.equal(f.calls.length,1);assert.equal(f.calls[0].signal.aborted,true);
+  });
+}
+for(const blocked of ['session','cwd','query','hash','path','tab','workspace','terminal','early','draft']){
+  test(`initial ${blocked} prevents any onboarding request`,async t=>{
+    const f=fixture(t,[pending,catalog,pending]);
+    if(['session','cwd','query'].includes(blocked)) f.browser.location.search=`?${blocked}=chosen`;
+    if(blocked==='hash')f.browser.location.hash='#chosen';if(blocked==='path')f.browser.location.pathname='/omnigent';
+    if(blocked==='tab')f.store.set('pi-web:tab-open-session','chosen');
+    if(blocked==='workspace')f.store.set('pi-web:last-open-by-workspace',JSON.stringify({cwd:'chosen'}));
+    if(blocked==='terminal')f.store.set('pi-web:terminal-tabs',JSON.stringify({tabs:[{id:'a'.repeat(32),cwd:'/tmp'}],open:true}));
+    if(blocked==='early')f.browser.__piOmnigentBoot={touched:true,expiresAt:Date.now()+30000,stop:()=>{}};
+    if(blocked==='draft')f.browser.document.querySelectorAll=()=>[{value:'unsent draft'}];
+    assert.equal(isUntouchedOmnigentHome(f.browser),false);f.start();await flush();assert.equal(f.calls.length,0);
+  });
+}
+test('ready/disabled/removed response stops the boot window',async t=>{
+  const f=fixture(t,[()=>({pending:false,sessionId:null})]);f.start();await flush();t.mock.timers.tick(40000);await flush();
+  assert.equal(f.calls.length,1);assert.deepEqual(f.selected,[]);
+});
+test('lifecycle is rechecked after the catalog; ready cannot open a stale saved setup',async t=>{
+  const f=fixture(t,[pending,catalog,()=>({pending:false,sessionId:null})]);f.start();await flush();
+  assert.equal(f.calls.length,3);assert.deepEqual(f.selected,[]);
+});
+test('navigation during catalog fetch cancels adoption even without an input event',async t=>{
+  const wait=deferred(),f=fixture(t,[pending,()=>wait.promise,pending]);f.start();await flush();
+  f.browser.location.search='?session=current';wait.resolve(catalog());await flush();
+  assert.deepEqual(f.selected,[]);assert.equal(f.calls.length,2);
+});
