new file mode 100644
index 0000000..5e58d25
--- /dev/null
+++ b/lib/omnigent-auto-open.ts
@@ -0,0 +1,74 @@
+import type { SessionInfo } from "./types";
+import type {} from "./omnigent-interaction-guard";
+
+const interactionEvents = ["pointerdown", "click", "keydown", "beforeinput", "input", "paste", "compositionstart", "drop", "wheel", "touchstart", "popstate", "hashchange"];
+
+/** Conservative first-home check; default sidebar project discovery is not a user choice. */
+export function isUntouchedOmnigentHome(browser: Window = window): boolean {
+  if (browser.__piOmnigentBoot?.touched || (browser.__piOmnigentBoot && Date.now() >= browser.__piOmnigentBoot.expiresAt)) return false;
+  if (browser.location.pathname !== "/" || browser.location.search || browser.location.hash) return false;
+  try {
+    if (browser.sessionStorage.getItem("pi-web:tab-open-session")) return false;
+    const terminals = JSON.parse(browser.sessionStorage.getItem("pi-web:terminal-tabs") || "null");
+    if (terminals?.open || terminals?.activeId || terminals?.tabs?.length) return false;
+    const memory = JSON.parse(browser.localStorage.getItem("pi-web:last-open-by-workspace") || "{}");
+    if (!memory || typeof memory !== "object" || Object.keys(memory).length) return false;
+    for (const element of browser.document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")) {
+      if (element.value) return false;
+    }
+    for (const element of browser.document.querySelectorAll<HTMLElement>('[contenteditable="true"]')) {
+      if (element.textContent) return false;
+    }
+    return true;
+  } catch { return false; }
+}
+
+/** A single cancellable boot window: <=30 seconds, <=30 attempts, no overlapping requests. */
+export function startOmnigentAutoOpen(
+  { eligible, select }: { eligible: () => boolean; select: (session: SessionInfo) => void },
+  browser: Window = window,
+): () => void {
+  let stopped = false, attempts = 0;
+  let retry: number | undefined, deadline: number | undefined;
+  const controller = new AbortController();
+  const cancel = () => {
+    if (stopped) return;
+    stopped = true;
+    controller.abort();
+    browser.clearTimeout(retry);
+    browser.clearTimeout(deadline);
+    browser.__piOmnigentBoot?.stop();
+    for (const event of interactionEvents) browser.removeEventListener(event, cancel, true);
+  };
+  const idle = () => !stopped && isUntouchedOmnigentHome(browser) && eligible();
+  for (const event of interactionEvents) browser.addEventListener(event, cancel, true);
+  if (!idle()) { cancel(); return cancel; }
+  deadline = browser.setTimeout(cancel, browser.__piOmnigentBoot ? Math.max(0, browser.__piOmnigentBoot.expiresAt - Date.now()) : 30_000);
+  const get = async (url: string) => {
+    const response = await browser.fetch(url, { signal: controller.signal, cache: "no-store" });
+    if (!response.ok) throw new Error("Onboarding unavailable");
+    return response.json();
+  };
+  const attempt = async () => {
+    if (!idle() || ++attempts > 30) { cancel(); return; }
+    try {
+      const pending = await get("/api/omnigent/onboarding");
+      if (!idle() || pending.pending !== true) { cancel(); return; }
+      if (typeof pending.sessionId === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(pending.sessionId)) {
+        const catalog = await get("/api/sessions?summary=1");
+        if (!idle()) { cancel(); return; }
+        const session = Array.isArray(catalog.sessions) && catalog.sessions.find((item: SessionInfo) => item.id === pending.sessionId);
+        if (session) {
+          // Recheck lifecycle after the catalog await; disable/remove/ready can race it.
+          const current = await get("/api/omnigent/onboarding");
+          if (!idle() || current.pending !== true) { cancel(); return; }
+          if (current.sessionId === session.id) { cancel(); select(session); return; }
+        }
+      }
+    } catch { /* A transient boot response can recover within this one bounded window. */ }
+    if (idle() && attempts < 30) retry = browser.setTimeout(() => { void attempt(); }, 1_000);
+    else cancel();
+  };
+  void attempt();
+  return cancel;
+}
diff --git a/lib/omnigent-interaction-guard.ts b/lib/omnigent-interaction-guard.ts
new file mode 100644
index 0000000..2924d0b
--- /dev/null
+++ b/lib/omnigent-interaction-guard.ts
@@ -0,0 +1,18 @@
+/** Runs in the document head, before hydration can replay clicks or replace typed text. */
+export const OMNIGENT_INTERACTION_GUARD = `(()=>{
+  if(window.__piOmnigentBoot)return;
+  const events=['pointerdown','click','keydown','beforeinput','input','paste','compositionstart','drop','wheel','touchstart','popstate','hashchange'];
+  const state=window.__piOmnigentBoot={touched:false,expiresAt:Date.now()+30000,stop:null};
+  let timer;
+  const stop=()=>{clearTimeout(timer);for(const event of events)window.removeEventListener(event,touch,true)};
+  const touch=()=>{state.touched=true;stop()};
+  state.stop=stop;
+  for(const event of events)window.addEventListener(event,touch,{capture:true,passive:true});
+  timer=setTimeout(stop,30000);
+})();`;
+
+declare global {
+  interface Window {
+    __piOmnigentBoot?: { touched: boolean; expiresAt: number; stop: () => void };
+  }
+}
