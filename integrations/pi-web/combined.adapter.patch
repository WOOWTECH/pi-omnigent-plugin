+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import vm from "node:vm";
+import test from "node:test";
+import ts from "typescript";
+
+const root = path.resolve(process.env.PI_PASEO_PLUGIN_ROOT || path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../.."));
+const runtimeLayout = await import(pathToFileURL(path.join(root, "src/runtime-layout.mjs")).href);
+const require = createRequire(import.meta.url);
+
+test("the host note remains visible without entering the strict Paseo daemon configuration", async (t) => {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), "pi-web-paseo-name-"));
+  t.after(() => fs.rmSync(home, { recursive: true, force: true }));
+  const loc = { home, agentDir: path.join(home, "agent"), stateDir: path.join(home, "state"), runtimeDir: path.join(home, "runtime"), paseoHome: path.join(home, "daemon"), port: 6769 };
+  const runtimeDir = runtimeLayout.runtimeDirectory(loc);
+  for (const dir of [loc.stateDir, loc.paseoHome, path.join(runtimeDir, "node_modules/@getpaseo/cli"), path.join(runtimeDir, "node_modules/@getpaseo/server/dist/server/web-ui")]) fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(runtimeDir, "node_modules/@getpaseo/cli/package.json"), '{"version":"0.11.2"}');
+  fs.writeFileSync(path.join(runtimeDir, "node_modules/@getpaseo/server/dist/server/web-ui/index.html"), "fixture");
+  runtimeLayout.markRuntimeReady(loc);
+  assert.equal(runtimeLayout.runtimeReady(loc), true, "Fixture uses the immutable runtime and its real readiness receipt");
+  fs.writeFileSync(path.join(loc.paseoHome, ".pi-paseo-owner.json"), JSON.stringify({ installationId: "fixture", home: loc.paseoHome }));
+  let state = { installationId: "fixture", phase: "running", desiredEnabled: true };
+  class RuntimeError extends Error { constructor(code) { super(code); this.code = code; } }
+  const readRecord = (file) => fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, "utf8")) : {};
+  const writeRecord = (file, value) => fs.writeFileSync(file, JSON.stringify(value));
+  const stubs = {
+    "./state.mjs": { RuntimeError, locations: () => loc, readState: () => state, updateState: (value) => (state = { ...state, ...value }), withRuntimeLock: async (fn) => fn(), processIdentity: () => "fixture", privateDirectory: (dir) => fs.mkdirSync(dir, { recursive: true }), atomicJson: writeRecord },
+    "./process.mjs": { findExecutable: () => assert.fail("No installers may execute"), runProcess: async (_command, args) => { assert.ok(args.includes("--version"), "Only fixture version detection is allowed"); assert.equal(args[0], path.join(runtimeDir, "node_modules/@getpaseo/cli/bin/paseo")); return "0.11.2"; } },
+    "./runtime-layout.mjs": runtimeLayout,
+    "./provider-launchers.mjs": { resolveProviderLaunchers: async () => ({}), configureProviders: () => ({}) },
+    "./onboarding.mjs": { readRecord, writeRecord, onboardingStatus: () => ({}) },
+    "./supervisor.mjs": {},
+    "./web-client.mjs": { WEB_BASE_PATH: "/paseo-web", ensureWebClient: async () => {}, webClientStatus: () => ({ ready: false }) },
+  };
+  const client = { getDaemonStatus: async () => ({ providers: [], relay: { enabled: true } }), reloadDaemonConfig: async () => ({ appliedPaths: ["agents.providers"], restartRequiredPaths: [], overrideControlledPaths: [] }), close: async () => {} };
+  const sandbox = vm.createContext({ process: { env: { HOME: home, PI_CODING_AGENT_DIR: loc.agentDir, PI_PASEO_STATE_DIR: loc.stateDir, PI_PASEO_RUNTIME_DIR: loc.runtimeDir }, versions: process.versions, platform: "fixture", getuid: () => 1000, execPath: process.execPath }, setTimeout, clearTimeout, console });
+  const loaded = new Map();
+  function load(file) {
+    if (loaded.has(file)) return loaded.get(file).exports;
+    const source = fs.readFileSync(file, "utf8").replaceAll("import.meta.url", JSON.stringify(pathToFileURL(file).href));
+    const code = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file + ".ts" }).outputText;
+    const record = { exports: {} };
+    loaded.set(file, record);
+    vm.runInContext(`(function(require,module,exports){${code}\n})`, sandbox, { filename: file })((specifier) => {
+      if (Object.hasOwn(stubs, specifier)) return stubs[specifier];
+      if (specifier.endsWith("/daemon-instance.js")) return { readDaemonInstance: async () => ({ pid: 5000, uid: 1000, startedAt: "fixture" }) };
+      if (specifier.endsWith("/config.js")) return { savePersistedConfig: (dir, config) => { assert.equal(Object.hasOwn(config.daemon, "name"), false); writeRecord(path.join(dir, "config.json"), config); } };
+      if (specifier.endsWith("/dist/utils/client.js")) return { connectToDaemon: async () => client };
+      if (specifier.startsWith(".")) return load(path.resolve(path.dirname(file), specifier));
+      return require(specifier);
+    }, record, record.exports);
+    return record.exports;
+  }
+  const api = load(path.join(root, "src/host-api.mjs"));
+  const runtime = load(path.join(root, "src/runtime.mjs"));
+  await api.saveConfig({ name: "Commercial fixture" });
+  assert.equal((await api.status()).settings.name, "Commercial fixture", "The saved name is visible in host preferences");
+  await runtime.activate();
+  assert.equal(readRecord(path.join(loc.paseoHome, "config.json")).daemon?.name, undefined, "Display labels must stay outside the strict daemon configuration");
+});
diff --git a/lib/paseo-onboarding.ts b/lib/paseo-onboarding.ts
new file mode 100644
index 0000000..63446e0
--- /dev/null
+++ b/lib/paseo-onboarding.ts
@@ -0,0 +1,23 @@
+import type { SessionManager } from "@earendil-works/pi-coding-agent";
+
+type OnboardingSession = {
+  send: (command: Record<string, unknown>) => Promise<unknown>;
+  inner: { sessionManager: SessionManager };
+};
+
+/** Persist the authorized request even when model preflight rejects it. */
+export async function promptPaseoOnboarding(session: OnboardingSession, message: string): Promise<boolean> {
+  const state = await session.send({ type: "get_state" }) as { model?: unknown };
+  if (state.model) {
+    try {
+      await session.send({ type: "prompt", message });
+      return false;
+    } catch { /* Record the request below if preflight did not persist it. */ }
+  }
+  const manager = session.inner.sessionManager;
+  if (!manager.getEntries().some((entry) => entry.type === "message" && entry.message.role === "user")) {
+    manager.appendMessage({ role: "user", content: message, timestamp: Date.now() });
+    return true;
+  }
+  return true;
+}
