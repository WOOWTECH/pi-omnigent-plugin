+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+import { createJiti } from 'jiti';
+const { readPendingOmnigentOnboarding } = await createJiti(import.meta.url).import('./omnigent-onboarding.ts');
+
+function fixture(t) {
+  const root=mkdtempSync(join(tmpdir(),'onboarding-api-'));
+  t.after(()=>rmSync(root,{recursive:true,force:true}));
+  const stateDir=join(root,'state'),sessionFile=join(root,'saved.jsonl');
+  mkdirSync(join(root,'src'));mkdirSync(stateDir);
+  writeFileSync(join(root,'package.json'),JSON.stringify({name:'@woowtech/pi-omnigent-plugin',type:'module'}));
+  writeFileSync(join(root,'src/web.mjs'), `import fs from 'node:fs';import path from 'node:path';
+    export function webLocations({env}){return {stateDir:env.PI_OMNIGENT_STATE_DIR};}
+    export async function packageLifecycle({env}){return JSON.parse(fs.readFileSync(path.join(env.PI_OMNIGENT_STATE_DIR,'lifecycle.json')));}
+    export function readOnboarding({env}){try{return JSON.parse(fs.readFileSync(path.join(env.PI_OMNIGENT_STATE_DIR,'onboarding.json')));}catch(e){if(e.code==='ENOENT')return {};throw e;}}
+  `);
+  writeFileSync(join(root,'src/runtime.mjs'),'throw new Error("A homepage read must never import the host runtime");');
+  writeFileSync(sessionFile,'existing setup conversation must remain byte-identical\n');
+  const write=(name,value)=>writeFileSync(join(stateDir,name+'.json'),JSON.stringify(value));
+  write('lifecycle',{active:true,registered:true});write('state',{enabled:true,phase:'needs-login',server:'private-server',password:'private-password'});
+  write('onboarding',{sessionId:'saved-omni-session',sessionFile,cwd:root});
+  return {root,stateDir,sessionFile,write,read:()=>readPendingOmnigentOnboarding({env:{PI_OMNIGENT_PLUGIN_ROOT:root,PI_OMNIGENT_STATE_DIR:stateDir}})};
+}
+
+test('the read-only API projects the saved pending Omnigent ID without probing a host or writing history',async t=>{
+  const f=fixture(t),before=createHash('sha256').update(readFileSync(f.sessionFile)).digest('hex');
+  assert.deepEqual(await f.read(),{pending:true,sessionId:'saved-omni-session'});
+  assert.equal(createHash('sha256').update(readFileSync(f.sessionFile)).digest('hex'),before);
+});
+
+for (const mode of ['disabled','ready','removed','unregistered','missing-record','missing-session','invalid-id','wrong-package','corrupt-state']) {
+  test(`onboarding projection handles ${mode} without creating or modifying sessions`,async t=>{
+    const f=fixture(t),before=readFileSync(f.sessionFile,'utf8');
+    if(mode==='disabled')f.write('state',{enabled:false,phase:'needs-login'});
+    if(mode==='ready')f.write('state',{enabled:true,phase:'ready'});
+    if(mode==='removed')f.write('lifecycle',{active:false,registered:false});
+    if(mode==='unregistered')f.write('lifecycle',{active:true,registered:false});
+    if(mode==='missing-record')rmSync(join(f.stateDir,'onboarding.json'));
+    if(mode==='missing-session')f.write('onboarding',{sessionId:'omni',sessionFile:join(f.root,'absent')});
+    if(mode==='invalid-id')f.write('onboarding',{sessionId:'../secret?x=1',sessionFile:f.sessionFile});
+    if(mode==='wrong-package')writeFileSync(join(f.root,'package.json'),JSON.stringify({name:'other'}));
+    if(mode==='corrupt-state')writeFileSync(join(f.stateDir,'state.json'),'broken');
+    assert.deepEqual(await f.read(),{pending:['missing-record','missing-session','invalid-id'].includes(mode),sessionId:null});
+    assert.equal(readFileSync(f.sessionFile,'utf8'),before);
+  });
+}
