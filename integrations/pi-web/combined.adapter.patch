--- /dev/null
+++ b/lib/paseo-plugin.ts
@@ -0,0 +1,137 @@
+import { randomUUID } from "node:crypto";
+import { statSync } from "node:fs";
+import { homedir } from "node:os";
+import { isAbsolute } from "node:path";
+import { DefaultPackageManager, getAgentDir, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { allowFileRoot } from "./file-access";
+import { getProjectTrustStatus } from "./project-trust";
+import { startRpcSession } from "./rpc-manager";
+import { invalidateSessionListCache } from "./session-reader";
+import { paseoHostApiUrl, paseoPackageRoot, readPaseoPackageManifest } from "./paseo-package";
+import { promptPaseoOnboarding } from "./paseo-onboarding";
+import { serializePluginPackageOperation } from "./plugin-package-lock";
+import { dispatchPaseoLifecycle, paseoLifecycleResult, paseoLifecycleTargets, PASEO_PACKAGE_NAME, type PaseoHostApi, type PaseoOnboardingRemember, type PaseoLifecycleAction, type PaseoLifecycleResult, type PaseoPackageRef } from "./paseo-plugin-lifecycle";
+
+export const PASEO_ONBOARDING_PROMPT = `請協助完成這個容器的 Paseo 連線初始化。插件正在背景安裝與啟動 Paseo，沿用容器內 Claude Code、Codex、Pi 的現有登入與權限。
+請先檢查 Paseo 狀態，說明還需要的連線資訊，並引導我到 /paseo/setup 完成配對與設定。使用 Paseo 官方 relay，透過設定頁提供的配對連結開啟網頁；官方配對不需要另外提供 Paseo 帳號密碼。
+若提供者尚未登入或登入過期，請引導我使用其官方登入流程。密碼、API Key、配對密鑰與配對連結只能在受保護的設定畫面或官方登入介面輸入，不要要求貼到對話、不要讀取或輸出憑證檔內容。
+完成後分別驗證 Claude Code、Codex、Pi 能在 Paseo 選擇模型與執行模式、新建對話、收到回覆並續聊。不要改成完整權限。`;
+
+type RuntimeState = { apis: Map<string, PaseoHostApi>; restore?: Promise<void> };
+const runtimeGlobal = globalThis as typeof globalThis & { __piPaseoHost?: RuntimeState };
+function runtimeState(): RuntimeState {
+  return runtimeGlobal.__piPaseoHost ??= { apis: new Map() };
+}
+
+export async function createPaseoOnboarding(cwd: string, remember?: PaseoOnboardingRemember, prompt = PASEO_ONBOARDING_PROMPT): Promise<string> {
+  const { session, realSessionId } = await startRpcSession(`__paseo__${randomUUID()}`, "", cwd);
+  try {
+    // Persist identity before any fallible post-creation command. Recovery must
+    // resume this session even if naming, preflight, prompting or shutdown fails.
+    await remember?.(realSessionId);
+    await session.send({ type: "set_session_name", name: "Paseo 連線初始化" });
+    allowFileRoot(cwd);
+    if (await promptPaseoOnboarding(session, prompt)) {
+      // Reopen from disk on continuation so the model sees the saved request.
+      await session.shutdown();
+    }
+    return realSessionId;
+  } catch (failure) {
+    await session.shutdown().catch(() => undefined);
+    throw failure;
+  } finally {
+    invalidateSessionListCache();
+  }
+}
+
+function isDisabled(entry: unknown): boolean {
+  if (!entry || typeof entry !== "object") return false;
+  const lists = entry as Record<string, unknown>;
+  return ["extensions", "skills", "prompts", "themes"].every((key) => Array.isArray(lists[key]) && lists[key].length === 0);
+}
+
+/** Metadata discovery does not resolve/load resources or install packages. */
+export function configuredPaseoPackages(cwd: string, globalOnly = false): PaseoPackageRef[] {
+  const agentDir = getAgentDir();
+  const trusted = !globalOnly && getProjectTrustStatus(cwd, agentDir).trusted;
+  const settings = SettingsManager.create(cwd, agentDir, { projectTrusted: trusted });
+  const manager = new DefaultPackageManager({ cwd, agentDir, settingsManager: settings });
+  return manager.listConfiguredPackages().flatMap((pkg) => {
+    if (globalOnly && pkg.scope === "project") return [];
+    if (!pkg.installedPath) return [];
+    let root: string;
+    try {
+      root = paseoPackageRoot(pkg.installedPath);
+      readPaseoPackageManifest(root);
+    } catch { return []; }
+    const scope = pkg.scope === "project" ? "project" : "global";
+    const entries = scope === "project" ? settings.getProjectSettings().packages : settings.getGlobalSettings().packages;
+    const configured = entries?.find((entry) => (typeof entry === "string" ? entry : entry.source) === pkg.source);
+    return [{ source: pkg.source, scope, packageName: PASEO_PACKAGE_NAME, installedPath: root, disabled: isDisabled(configured) }];
+  });
+}
+
+export async function loadPaseoHostApi(pkg: PaseoPackageRef, allowDisabled = false): Promise<PaseoHostApi> {
+  const apiUrl = paseoHostApiUrl(pkg, allowDisabled);
+  const cached = runtimeState().apis.get(apiUrl);
+  if (cached) return cached;
+  const api = await import(/* webpackIgnore: true */ apiUrl) as PaseoHostApi;
+  if (!["lifecycle", "restore", "status", "diagnostics", "pair", "saveConfig"].every((name) => typeof (api as unknown as Record<string, unknown>)[name] === "function")) {
+    throw new Error("Paseo runtime API unavailable");
+  }
+  runtimeState().apis.set(apiUrl, api);
+  return api;
+}
+
+export async function applyPaseoPackageLifecycle(
+  action: PaseoLifecycleAction,
+  cwd: string,
+  before: PaseoPackageRef[],
+  after: PaseoPackageRef[],
+  successful: Pick<PaseoPackageRef, "source" | "scope">[],
+  preloaded?: PaseoHostApi,
+): Promise<PaseoLifecycleResult | undefined> {
+  const targets = paseoLifecycleTargets(action, before, after, successful);
+  let result: PaseoLifecycleResult | undefined;
+  for (const target of targets) {
+    try {
+      const packages = after.filter((pkg) => pkg.packageName === PASEO_PACKAGE_NAME);
+      const remaining = packages.find((pkg) => !pkg.disabled);
+      const api = remaining ? await loadPaseoHostApi(remaining) : preloaded ?? await loadPaseoHostApi(target, true);
+      if ((action === "disable" || action === "remove") && remaining) {
+        // Reconcile the remaining registration without clearing a manual Stop.
+        result = paseoLifecycleResult(await api.restore({ createOnboarding: (prompt, remember) => createPaseoOnboarding(cwd, remember, prompt) }));
+      } else {
+        result = await dispatchPaseoLifecycle(api, action, cwd, remaining ?? target, packages, (prompt, remember) => createPaseoOnboarding(cwd, remember, prompt));
+      }
+    } catch {
+      result = { error: "Paseo 整合服務尚未載入；請檢查插件安裝位置並開啟設定頁。" };
+    }
+  }
+  return result;
+}
+
+/** Once per process; project recovery is limited to an explicit existing cwd. */
+export function restorePaseoPlugin(): Promise<void> {
+  return runtimeState().restore ??= serializePluginPackageOperation(async () => {
+    let cwd = homedir();
+    let globalOnly = true;
+    const configuredCwd = process.env.PI_PASEO_CWD;
+    if (configuredCwd && isAbsolute(configuredCwd)) {
+      try {
+        if (statSync(configuredCwd).isDirectory()) {
+          cwd = configuredCwd;
+          globalOnly = false;
+        }
+      } catch { /* Missing or unreadable project: recover global packages only. */ }
+    }
+    const packages = configuredPaseoPackages(cwd, globalOnly);
+    const enabled = packages.find((pkg) => !pkg.disabled);
+    if (!enabled) return;
+    const api = await loadPaseoHostApi(enabled);
+    await api.restore({ createOnboarding: (prompt, remember) => createPaseoOnboarding(cwd, remember, prompt) });
+  }).catch(() => {
+    // Status/diagnostics expose a safe retry path; never log subprocess errors.
+    console.warn("[pi-web] Paseo startup recovery needs attention; open /paseo/setup.");
+  });
+}
