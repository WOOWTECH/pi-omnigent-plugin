+    <section className="paseo-plugin-panel" aria-label="Paseo 連線設定">
+      <ConfigSectionTitle>Paseo 連線</ConfigSectionTitle>
+      <p style={{ fontSize: 13, color: "var(--text-muted)", margin: 0, lineHeight: 1.7 }}>
