+    } catch (failure) {
+      if (!current()) return;
+      setError(failure instanceof Error ? failure.message : "Paseo 操作尚未完成。");
+    } finally { if (current()) { versions.mutation = false; setBusy(""); } }
+  };
+
+  const sessionUrl = paseoSessionUrl(status.onboardingSessionId);
+  const packageDisabled = disabled || status.packageEnabled === false;
+  const serviceReady = statusCurrent && !packageDisabled && status.enabled !== false && status.daemon?.healthy === true && status.phase !== "restart_required";
+  const mutationBusy = Boolean(busy) && !["diagnose", "models"].includes(busy);
