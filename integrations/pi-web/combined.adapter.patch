diff --git a/e2e/paseo-mobile-scroll-runner.mjs b/e2e/paseo-mobile-scroll-runner.mjs
new file mode 100644
index 0000000..5f5aa46
--- /dev/null
+++ b/e2e/paseo-mobile-scroll-runner.mjs
@@ -0,0 +1,32 @@
+import {spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {createServer} from 'node:net';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {setTimeout as delay} from 'node:timers/promises';
+
+// Production build, isolated HOME and agent store; never use operator settings.
+const home=mkdtempSync(join(tmpdir(),'paseo-scroll-e2e-'));
+const probe=createServer();probe.listen(0,'127.0.0.1');await once(probe,'listening');
+const port=probe.address().port;await new Promise(resolve=>probe.close(resolve));
+const base=`http://127.0.0.1:${port}`;
+const env={...process.env,HOME:home,PI_CODING_AGENT_DIR:join(home,'agent'),PI_WEB_PASSWORD:'',PI_PASEO_PLUGIN_ROOT:'',PI_OMNIGENT_PLUGIN_ROOT:'',PI_PASEO_DISCOVERY_ONLY:'1',PI_PASEO_SKIP_POSTINSTALL:'1',NEXT_TELEMETRY_DISABLED:'1'};
+const server=spawn(process.execPath,['node_modules/next/dist/bin/next','start','-H','127.0.0.1','-p',String(port)],{env,stdio:['ignore','ignore','inherit']});
+const stopped=once(server,'exit');
+try {
+  let ready=false;
+  for(let i=0;i<120&&server.exitCode===null;i++){
+    if(await fetch(base).then(r=>r.ok,()=>false)){ready=true;break;}
+    await delay(250);
+  }
+  if(!ready)throw new Error('Production server did not become ready');
+  const child=spawn(process.execPath,['e2e/paseo-mobile-scroll.mjs'],{env:{...env,PI_WEB_E2E_URL:base},stdio:'inherit'});
+  const [code]=await once(child,'exit');
+  if(code!==0)throw new Error('Paseo scroll regression failed');
+} finally {
+  server.kill('SIGTERM');
+  const timeout=setTimeout(()=>server.kill('SIGKILL'),5000);
+  await stopped;clearTimeout(timeout);
+  rmSync(home,{recursive:true,force:true});
+}
diff --git a/e2e/paseo-mobile-scroll.mjs b/e2e/paseo-mobile-scroll.mjs
new file mode 100644
index 0000000..e94e62e
--- /dev/null
+++ b/e2e/paseo-mobile-scroll.mjs
@@ -0,0 +1,98 @@
+import assert from 'node:assert/strict';
+import {chromium} from 'playwright';
+
+// Existing Pi Web build, real components/styles/touch events. Mock only Paseo
+// data to reproduce long content without credentials or runtime mutations.
+const base = process.env.PI_WEB_E2E_URL || 'http://127.0.0.1:30141';
+const browser = await chromium.launch({
+  ...(process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ? {executablePath:process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH} : {}),
+});
+const status = {
+  enabled:true,packageEnabled:true,packageInstalled:true,phase:'running',
+  daemon:{healthy:true,running:true,installed:true},
+  providers:['claude','codex','pi'].map(id=>({id,chatVerified:true})),
+};
+const viewports = [
+  {name:'phone',width:390,height:780,mobile:true},
+  {name:'small-phone',width:360,height:640,mobile:true},
+  {name:'landscape',width:844,height:390,mobile:true},
+  {name:'desktop',width:1280,height:900,mobile:false},
+  {name:'setup-phone',width:390,height:780,mobile:true,setup:true},
+];
+const cases = process.env.PI_WEB_SCROLL_SURFACE === 'setup'
+  ? viewports.filter(c=>!c.setup).map(c=>({...c,name:`setup-${c.name}`,setup:true}))
+  : viewports;
+const results = [];
+try {
+  for (const c of cases) {
+    const context = await browser.newContext({viewport:{width:c.width,height:c.height},isMobile:c.mobile,hasTouch:c.mobile,locale:'en-US'});
+    try {
+      const page = await context.newPage();
+      const errors=[];page.on('pageerror',e=>errors.push(e.name));
+      await page.route('**/api/plugin-paseo*', async route => {
+        const request=route.request();
+        const body=request.method()==='POST' ? request.postDataJSON() : {};
+        assert.ok(!body.action || body.action==='models', 'Layout test must not mutate runtime');
+        await route.fulfill({json:body.action==='models' ? {
+          modes:[],models:Array.from({length:60},(_,i)=>({id:`model-${i}`,label:`Scroll model ${i} ${'long-name-'.repeat(8)}`})),
+        } : status});
+      });
+      await page.goto(new URL(c.setup ? '/paseo/setup' : '/',base).href,{waitUntil:'domcontentloaded'});
+      if(!c.setup) {
+        await page.getByRole('button',{name:/^(Settings|設定)$/}).waitFor({state:'attached'});
+        // Open the dialog directly; scroll assertions below use physical input only.
+        await page.getByRole('button',{name:/^(Settings|設定)$/}).evaluate(el=>el.click());
+        const select=page.locator('select').filter({has:page.locator('option[value="paseo"]')});
+        if(await select.isVisible())await select.selectOption('paseo');
+        else await page.locator('.settings-section-tab').filter({hasText:'Paseo'}).click();
+      }
+      const panel=page.getByRole('region',{name:'Paseo 連線設定'});
+      await panel.waitFor();
+      const button=panel.getByRole('button',{name:'讀取 Pi 模型',exact:true});
+      await page.waitForFunction(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.textContent==='讀取 Pi 模型');return b&&!b.disabled;});
+      const cdp=await context.newCDPSession(page);
+      async function swipe(direction=1) {
+        const box=await panel.boundingBox();
+        const x=Math.min(c.width-32,box.x+box.width*0.65);
+        const top=Math.max(90,box.y+30),bottom=Math.min(c.height-48,box.y+box.height-32);
+        if(c.mobile){
+          const start=direction>0?bottom:top,end=direction>0?top:bottom;
+          await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x,y:start}]});
+          for(let i=1;i<=10;i++){
+            await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x,y:start+(end-start)*i/10}]});
+            await page.waitForTimeout(16);
+          }
+          await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});
+        }else{
+          await page.mouse.move(x,bottom);await page.mouse.wheel(0,direction*600);
+        }
+        await page.waitForTimeout(100);
+      }
+      async function inViewport(locator) {
+        return locator.evaluate(el=>{
+          const r=el.getBoundingClientRect();
+          if(r.top<0||r.bottom>innerHeight||r.left<0||r.right>innerWidth)return false;
+          const hit=document.elementFromPoint(r.x+r.width/2,r.y+r.height/2);
+          return hit===el||el.contains(hit);
+        });
+      }
+      async function reach(locator,direction=1) {
+        for(let i=0;i<35 && !(await inViewport(locator));i++)await swipe(direction);
+        assert.ok(await inViewport(locator), `${c.name}: control reachable by ${c.mobile?'touch':'wheel'} scrolling`);
+      }
+      // Never let click/scrollIntoView hide a broken gesture scroll path.
+      await reach(button);
+      await button.click();
+      const last=panel.locator('li').last();
+      await last.waitFor();
+      await reach(last);
+      assert.ok((await last.textContent()).startsWith('Scroll model 59'));
+      assert.equal(await panel.evaluate(el=>el.scrollWidth>el.clientWidth+1),false,`${c.name}: long model names must wrap`);
+      await reach(panel.getByText('Paseo 連線',{exact:true}),-1);
+      assert.deepEqual(errors,[]);
+      results.push({case:c.name,touch:c.mobile,bottomControls:true,expandedCatalog:true,returnToTop:true,pageErrors:0});
+      console.log(JSON.stringify(results.at(-1)));
+    } finally {await context.close();}
+  }
+} finally {await browser.close();}
+assert.equal(results.length,cases.length);
