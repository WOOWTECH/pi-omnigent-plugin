+import { readFile, stat } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { getAgentDir } from "@earendil-works/pi-coding-agent";
+
+export interface PendingOmnigentOnboarding { pending: boolean; sessionId: string | null }
+const inactive = (): PendingOmnigentOnboarding => ({ pending: false, sessionId: null });
+
+/** Local read only: never discover engines, probe a host, or create/reload a chat. */
+export async function readPendingOmnigentOnboarding(
+  { env = process.env }: { env?: NodeJS.ProcessEnv } = {},
+): Promise<PendingOmnigentOnboarding> {
+  try {
+    const root = resolve(env.PI_OMNIGENT_PLUGIN_ROOT || join(getAgentDir(), "git/github.com/WOOWTECH/pi-omnigent-plugin"));
+    const pkg = JSON.parse(await readFile(join(root, "package.json"), "utf8"));
+    if (pkg.name !== "@woowtech/pi-omnigent-plugin") return inactive();
+    // The installation path is operator-controlled, never supplied by an HTTP client.
+    const web = await import(/* webpackIgnore: true */ pathToFileURL(join(root, "src/web.mjs")).href);
+    const lifecycle = await web.packageLifecycle({ env });
+    if (lifecycle.active !== true || lifecycle.registered !== true) return inactive();
+    const { stateDir } = web.webLocations({ env });
+    let state;
+    try { state = JSON.parse(await readFile(join(stateDir, "state.json"), "utf8")); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      state = { enabled: true, phase: "new" };
+    }
+    if (state.enabled === false || !["new", "needs-login", "installing", "connecting", "verifying", "needs-verification", "error"].includes(state.phase)) return inactive();
+    const saved = web.readOnboarding({ env });
+    const sessionId = typeof saved.sessionId === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(saved.sessionId) ? saved.sessionId : null;
+    const exists = sessionId && typeof saved.sessionFile === "string" && await stat(saved.sessionFile).then(file => file.isFile(), () => false);
+    // Boot may register the plugin before it persists the setup session.
+    return { pending: true, sessionId: exists ? sessionId : null };
+  } catch {
+    // Never expose installation paths, credentials or private state in a homepage response.
+    return inactive();
+  }
+}
