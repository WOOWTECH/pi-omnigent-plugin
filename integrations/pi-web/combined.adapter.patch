+export interface OmnigentEngine {
+  key: string;
+  installed: boolean;
+  version: string | null;
+  configured: boolean | string | null;
+  ready: boolean;
+  verified: boolean;
+  reason: string | null;
+  models: { id: string; label: string }[];
+}
+
+export interface OmnigentView {
+  installed: boolean;
+  active: boolean;
+  version: string | null;
+  phase: string;
+  server: string | null;
+  loginConfirmed: boolean;
+  host: { id: string | null; name: string | null; connected: boolean };
+  engines: OmnigentEngine[];
+  onboardingUrl: string | null;
+  operation?: { ok: boolean; code: string | null };
+}
