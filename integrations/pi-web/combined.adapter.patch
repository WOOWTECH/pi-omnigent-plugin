+      } else {
+        if (kind === "config") nameEdited.current = false;
+        if (paseoSessionUrl(result.onboardingSessionId)) setStatus((current) => ({ ...current, onboardingSessionId: result.onboardingSessionId as string }));
+        setNotice(kind === "config" ? "設定已儲存。" : kind === "disable" ? "已要求停止 Paseo 服務。" : "初始化已排入背景處理；請繼續初始化對話。" );
+      }
+      versions.mutation = false;
