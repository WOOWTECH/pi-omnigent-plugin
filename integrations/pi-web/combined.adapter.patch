+            <p style={{ fontSize: 13, lineHeight: 1.7, margin: 0 }}>官方 relay 使用加密配對，無須額外輸入 Paseo 帳號密碼。產生連結後開啟 Paseo 完成配對，接著選擇這個容器、提供者與模型。</p>
+            <ConfigDetailActions>
+              <ConfigButton variant="primary" onClick={() => void action("pair")} disabled={Boolean(busy) || !serviceReady}>{busy === "pair" ? "產生中…" : "產生配對連結"}</ConfigButton>
+              {pairUrl && <a href={pairUrl} target="_blank" rel="noopener noreferrer" referrerPolicy="no-referrer" className="config-button config-button-secondary config-button-default">使用配對連結開啟 Paseo</a>}
+              {pairUrl && <ConfigButton onClick={() => {
+                void (navigator.clipboard?.writeText(new URL(pairUrl, window.location.href).href) ?? Promise.reject()).then(() => setNotice("配對連結已複製。請只交給你自己的 Paseo 裝置。"), () => setError("無法存取剪貼簿，請使用配對按鈕開啟 Paseo。"));
+              }}>複製配對連結</ConfigButton>}
+            </ConfigDetailActions>
+            <p style={{ fontSize: 12, color: "var(--text-muted)", lineHeight: 1.7, margin: 0 }}>提供者需要補登入時，請依初始化對話的官方登入步驟操作。API Key、密碼與配對密鑰請在官方登入畫面或 Pi Web 的模型設定輸入。</p>
+          </div>
+        </>
+      )}
+      {setup && <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
+        <ConfigSectionTitle>模型、模式與思考等級</ConfigSectionTitle>
+        {!serviceReady && <p style={{ fontSize: 12, margin: 0 }}>等待 Paseo 服務連線確認後，即可配對並讀取模型。請啟動服務或重新整理狀態。</p>}
+        <ConfigDetailActions>{PASEO_PROVIDERS.map((provider) => <ConfigButton key={provider.id} onClick={() => void action("models", provider.id)} disabled={Boolean(busy) || !serviceReady}>讀取 {provider.label} 模型</ConfigButton>)}</ConfigDetailActions>
+        {catalogs.map((catalog) => <div key={catalog.provider} style={{ fontSize: 12, lineHeight: 1.8 }}>
+          <strong>{PASEO_PROVIDERS.find((provider) => provider.id === catalog.provider)?.label}</strong>
+          <p style={{ margin: 0 }}>模式：{catalog.modes.map((mode) => mode.label).join("、") || "Paseo 尚未回報可用模式"}</p>
+          {catalog.models.length ? <ul style={{ margin: 0 }}>{catalog.models.map((model) => <li key={model.id}>{model.label}{model.isDefault ? "（預設）" : ""}{model.thinkingOptions.length ? `；思考：${model.thinkingOptions.map((option) => option.label).join("、")}` : ""}</li>)}</ul> : <p style={{ margin: 0 }}>尚無可用模型，請檢查提供者登入。</p>}
+        </div>)}
+      </div>}
+      {checks.length > 0 && <ul style={{ fontSize: 12, lineHeight: 1.8, margin: 0 }}>{checks.map((check, index) => <li key={`${check.name}:${index}`}>{check.name}：{check.status}{check.message ? ` — ${check.message}` : ""}</li>)}</ul>}
+      {notice && <ConfigFooterStatus summary={notice} />}
+      {error && <div role="alert"><ConfigFooterStatus summary={error} tone="error" /></div>}
+    </section>
+  );
+}
