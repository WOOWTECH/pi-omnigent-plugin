@@ -0,0 +1,17 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createJiti } from "jiti";
+const jiti = createJiti(import.meta.url, { alias: { "@/": new URL("../../../", import.meta.url).pathname } });
+const { GET, POST } = await jiti.import("./route.ts");
+test("Omnigent route rejects cross-origin reads and writes before accessing plugin runtime", async () => {
+  for (const [method, handler] of [["GET", GET], ["POST", POST]]) {
+    const r = await handler(new Request("http://localhost/api/omnigent", { method, headers: { host: "localhost", origin: "https://evil.example", "content-type": "application/json" } }));
+    assert.equal(r.status, 403);
+  }
+});
+test("Omnigent POST refuses non-JSON and invalid JSON without echoing source or password", async () => {
+  let r = await POST(new Request("http://localhost/api/omnigent", { method: "POST", headers: { host: "localhost" }, body: "password=never-echo" }));
+  assert.equal(r.status, 415);
+  r = await POST(new Request("http://localhost/api/omnigent", { method: "POST", headers: { host: "localhost", "content-type": "application/json" }, body: '{"password":"never-echo"' }));
+  assert.equal(r.status, 400); assert.equal((await r.text()).includes("never-echo"), false);
+});
diff --git a/app/api/omnigent/route.ts b/app/api/omnigent/route.ts
new file mode 100644
index 0000000..6026304
--- /dev/null
+++ b/app/api/omnigent/route.ts
@@ -0,0 +1,28 @@
+import { NextResponse } from "next/server";
+import { createOmnigentBridge } from "@/lib/omnigent-runtime";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const bridge = createOmnigentBridge();
+const reply = (value: unknown, status = 200) => NextResponse.json(value, { status, headers: { "Cache-Control": "no-store" } });
+function failure(error: unknown) {
+  const code = error && typeof error === "object" && "code" in error && typeof error.code === "string" && /^[A-Z_0-9]+$/.test(error.code) ? error.code : "OMNIGENT_FAILED";
+  return reply({ error: { code } }, code.startsWith("INVALID_") ? 400 : code === "PLUGIN_UNAVAILABLE" ? 409 : 503);
+}
+export async function GET(request: Request) {
+  if (!isApiRequestAllowed(request)) return reply({ error: { code: "UNTRUSTED_REQUEST" } }, 403);
+  try { return reply(await bridge.read()); } catch (error) { return failure(error); }
+}
+export async function POST(request: Request) {
+  if (!isApiRequestAllowed(request)) return reply({ error: { code: "UNTRUSTED_REQUEST" } }, 403);
+  if (!hasJsonContentType(request)) return reply({ error: { code: "JSON_REQUIRED" } }, 415);
+  try {
+    const raw = await request.text();
+    if (raw.length > 8192) return reply({ error: { code: "REQUEST_TOO_LARGE" } }, 413);
+    let body: unknown;
+    try { body = JSON.parse(raw); } catch { return reply({ error: { code: "INVALID_JSON" } }, 400); }
+    if (!body || typeof body !== "object" || Array.isArray(body)) return reply({ error: { code: "INVALID_REQUEST" } }, 400);
+    return reply(await bridge.act(body as Record<string, unknown>));
+  } catch (error) { return failure(error); }
+}
