@@ -0,0 +1,69 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+const { createOmnigentBridge } = await createJiti(import.meta.url).import("./omnigent-runtime.ts");
+
+function fixture() {
+  const calls = [];
+  const current = { phase: "needs-verification", enabled: true, loginConfirmed: true, server: "https://omni.example",
+    host: { id: "own-host", name: "Own host", connected: true, accessToken: "must-never-escape" },
+    engines: { claude: { available: true, version: "2.1.0", configured: "needs-auth" } }, verification: {}, password: "must-never-escape" };
+  const plugin = { version: "0.2.2", lifecycle: async () => ({ active: true }), onboarding: () => ({ sessionId: "own-onboarding", sessionFile: "/private/hidden" }),
+    runtime: { status: async () => current,
+      catalog: async () => ({ ok: true, data: { engines: { claude: { models: [], apiKey: "must-never-escape" } } } }),
+      initialize: async input => { calls.push(input); return { ok: true, token: "must-never-escape" }; },
+      verify: async input => { calls.push(input); return { ok: false, busy: true, error: { code: "OPERATION_BUSY", message: "must-never-escape" } }; },
+      disconnect: async () => { calls.push("disconnect"); return { ok: true }; } } };
+  return { current, plugin, calls, bridge: createOmnigentBridge(async () => plugin) };
+}
+test("reading connection status preserves stages and never exposes credential-bearing raw payloads", async () => {
+  const { bridge, calls } = fixture(); const view = await bridge.read();
+  assert.equal(view.host.connected, true); assert.equal(view.phase, "needs-verification");
+  assert.equal(view.engines[0].configured, "needs-auth"); assert.equal(view.engines[0].verified, false);
+  assert.equal(view.onboardingUrl, "/?session=own-onboarding");
+  assert.equal(JSON.stringify(view).includes("must-never-escape"), false);
+  assert.equal(JSON.stringify(view).includes("/private/"), false); assert.equal(calls.length, 0);
+});
+test("connect passes fresh credentials directly to runtime with chat disabled, then projects only safe metadata", async () => {
+  const { bridge, calls } = fixture(); const view = await bridge.act({ action: "connect", server: "https://omni.example", username: "person", password: "private-password" });
+  assert.equal(calls[0].password, "private-password"); assert.equal(calls[0].verify, false);
+  assert.equal(JSON.stringify(view).includes("private-password"), false); assert.equal(JSON.stringify(view).includes("must-never-escape"), false);
+});
+test("successful native connection changes synchronize the setup wizard; reads, verification and failures do not", async () => {
+  const f = fixture(); let refreshes = 0;
+  f.plugin.refreshOnboarding = async () => { refreshes++; };
+  await f.bridge.read();
+  await f.bridge.act({ action: "verify" });
+  assert.equal(refreshes, 0);
+  await f.bridge.act({ action: "connect", server: "https://omni.example", username: "person", password: "private-password" });
+  await f.bridge.act({ action: "disconnect", confirm: true });
+  assert.equal(refreshes, 2);
+  f.plugin.runtime.initialize = async () => ({ ok: false });
+  await f.bridge.act({ action: "connect", server: "https://omni.example", username: "person", password: "private-password" });
+  assert.equal(refreshes, 2);
+});
+test("wizard synchronization failure cannot turn a successful login into failure or expose an error", async () => {
+  const f = fixture(); f.plugin.refreshOnboarding = async () => { throw new Error("private-refresh-token"); };
+  const result = await f.bridge.act({ action: "connect", server: "https://omni.example", username: "person", password: "private-password" });
+  assert.equal(result.operation.ok, true);
+  assert.equal(JSON.stringify(result).includes("private-refresh-token"), false);
+});
+test("unsupported inputs cannot invoke runtime or pick executable paths", async () => {
+  const { bridge, calls } = fixture();
+  for (const body of [{ action: "execute", command: "any" }, { action: "disconnect" }, { action: "connect", server: "https://user:password@omni.example", username: "person", password: "password" }, { action: "verify", engine: "shell" }, { action: "verify", model: "any" }]) {
+    await assert.rejects(bridge.act(body));
+  }
+  assert.equal(calls.length, 0);
+});
+test("explicit model verification cannot become a silent model turn from a page read", async () => {
+  const { bridge, calls } = fixture(); const result = await bridge.act({ action: "verify", engine: "claude", model: "opus" });
+  assert.deepEqual(calls, [{ engine: "claude", model: "opus" }]);
+  assert.deepEqual(result.operation, { ok: false, code: "OPERATION_BUSY" });
+});
+test("disabled and absent plugins cannot operate or probe a host", async () => {
+  const ctx = fixture(); ctx.plugin.lifecycle = async () => ({ active: false });
+  ctx.plugin.runtime.status = () => assert.fail("disabled plugin must not probe a host");
+  assert.equal((await ctx.bridge.read()).active, false);
+  await assert.rejects(ctx.bridge.act({ action: "verify" }));
+  assert.equal((await createOmnigentBridge(async () => null).read()).installed, false);
+});
diff --git a/lib/omnigent-runtime.ts b/lib/omnigent-runtime.ts
new file mode 100644
index 0000000..1728a7a
--- /dev/null
+++ b/lib/omnigent-runtime.ts
@@ -0,0 +1,111 @@
+import { existsSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { getAgentDir } from "@earendil-works/pi-coding-agent";
+import type { OmnigentView } from "./omnigent-types";
+
+type RecordValue = Record<string, unknown>;
+const record = (value: unknown): RecordValue => value && typeof value === "object" && !Array.isArray(value) ? value as RecordValue : {};
+const text = (value: unknown): string | null => typeof value === "string" ? value.replace(/[\x00-\x1f\x7f]/g, "").slice(0, 256) : null;
+const code = (value: unknown): string | null => typeof value === "string" && /^[A-Z_0-9]{1,64}$/.test(value) ? value : null;
+
+interface Runtime {
+  status(): Promise<RecordValue>;
+  catalog(): Promise<RecordValue>;
+  initialize(options: RecordValue): Promise<RecordValue>;
+  verify(options: RecordValue): Promise<RecordValue>;
+  disconnect(): Promise<RecordValue>;
+}
+interface Plugin {
+  runtime: Runtime;
+  lifecycle(): Promise<{ active: boolean }>;
+  onboarding(): RecordValue;
+  version: string;
+  refreshOnboarding?(): Promise<unknown>;
+}
+
+async function loadPlugin(): Promise<Plugin | null> {
+  // This root is operator-controlled; HTTP callers can never choose code paths.
+  const root = resolve(process.env.PI_OMNIGENT_PLUGIN_ROOT || join(getAgentDir(), "git/github.com/WOOWTECH/pi-omnigent-plugin"));
+  const manifest = join(root, "package.json");
+  if (!existsSync(manifest)) return null;
+  const pkg = JSON.parse(readFileSync(manifest, "utf8"));
+  if (pkg.name !== "@woowtech/pi-omnigent-plugin") return null;
+  const runtime = await import(/* webpackIgnore: true */ pathToFileURL(join(root, "src/runtime.mjs")).href) as Runtime;
+  const web = await import(/* webpackIgnore: true */ pathToFileURL(join(root, "src/web.mjs")).href) as {
+    packageLifecycle(): Promise<{ active: boolean }>;
+    readOnboarding(): RecordValue;
+    refreshOnboardingSession?(): Promise<unknown>;
+  };
+  return { runtime, lifecycle: () => web.packageLifecycle(), onboarding: () => web.readOnboarding(), version: pkg.version,
+    refreshOnboarding: web.refreshOnboardingSession ? () => web.refreshOnboardingSession!() : undefined };
+}
+
+function safeServer(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  try {
+    const url = new URL(value);
+    return ["https:", "http:"].includes(url.protocol) && !url.username && !url.password && !url.search && !url.hash ? url.href.replace(/\/+$/, "") : null;
+  } catch { return null; }
+}
+
+const emptyView = (installed = false): OmnigentView => ({ installed, active: false, version: null, phase: "unavailable", server: null,
+  loginConfirmed: false, host: { id: null, name: null, connected: false }, engines: [], onboardingUrl: null });
+
+/** The same operations the installed plugin exposes, projected to safe UI data. */
+export function createOmnigentBridge(load: () => Promise<Plugin | null> = loadPlugin) {
+  async function snapshot(plugin: Plugin): Promise<OmnigentView> {
+    const lifecycle = await plugin.lifecycle();
+    if (!lifecycle.active) return { ...emptyView(true), version: plugin.version, phase: "disabled" };
+    const current = await plugin.runtime.status();
+    const host = record(current.host);
+    const catalog = current.loginConfirmed === true && host.connected === true ? await plugin.runtime.catalog() : {};
+    const catalogEngines = record(record(catalog.data).engines);
+    const engines = record(current.engines), proofs = record(current.verification);
+    const onboard = plugin.onboarding();
+    const sessionId = typeof onboard.sessionId === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(onboard.sessionId) ? onboard.sessionId : null;
+    return { installed: true, active: true, version: plugin.version, phase: text(current.phase) || "unknown",
+      server: safeServer(current.server), loginConfirmed: current.loginConfirmed === true,
+      host: { id: text(host.id), name: text(host.name), connected: host.connected === true },
+      onboardingUrl: sessionId ? `/?session=${encodeURIComponent(sessionId)}` : null,
+      engines: ["claude", "codex", "pi"].map(key => {
+        const engine = record(engines[key]), proof = record(proofs[key]), inventory = record(catalogEngines[key]);
+        return { key, installed: engine.available === true, version: text(engine.version),
+          configured: typeof engine.configured === "boolean" ? engine.configured : text(engine.configured),
+          ready: inventory.ready === true, verified: proof.ok === true && proof.cleanup === "stopped" && proof.hostId === host.id && proof.server === current.server && (!proof.cliVersion || proof.cliVersion === engine.version),
+          reason: code(proof.reason), models: (Array.isArray(inventory.models) ? inventory.models : []).flatMap(value => {
+            const model = record(value), id = text(model.id);
+            return id ? [{ id, label: text(model.displayName) || id }] : [];
+          }) };
+      }) };
+  }
+  return {
+    async read(): Promise<OmnigentView> { const plugin = await load(); return plugin ? snapshot(plugin) : emptyView(); },
+    async act(body: RecordValue): Promise<OmnigentView> {
+      const plugin = await load();
+      if (!plugin || !(await plugin.lifecycle()).active) throw Object.assign(new Error("Plugin unavailable"), { code: "PLUGIN_UNAVAILABLE" });
+      let result: RecordValue;
+      if (body.action === "connect") {
+        if (typeof body.server !== "string" || !body.server.trim() || body.server.length > 2048 || !safeServer(body.server.trim())
+          || typeof body.username !== "string" || !body.username.trim() || body.username.length > 256
+          || typeof body.password !== "string" || !body.password || body.password.length > 4096) {
+          throw Object.assign(new Error("Missing setup fields"), { code: "INVALID_SETUP" });
+        }
+        result = await plugin.runtime.initialize({ server: body.server.trim(), username: body.username.trim(), password: body.password, verify: false });
+      } else if (body.action === "verify") {
+        const engine = typeof body.engine === "string" && ["claude", "codex", "pi"].includes(body.engine) ? body.engine : undefined;
+        if (body.engine !== undefined && !engine) throw Object.assign(new Error("Invalid engine"), { code: "INVALID_ENGINE" });
+        if (body.model !== undefined && (typeof body.model !== "string" || body.model.length > 256 || !engine)) throw Object.assign(new Error("Invalid model"), { code: "INVALID_MODEL" });
+        result = await plugin.runtime.verify({ ...(engine ? { engine } : {}), ...(body.model ? { model: body.model } : {}) });
+      } else if (body.action === "disconnect" && body.confirm === true) result = await plugin.runtime.disconnect();
+      else throw Object.assign(new Error("Unsupported action"), { code: "INVALID_ACTION" });
+      if (result.ok === true && ["connect", "disconnect"].includes(String(body.action))) {
+        // Refresh only the plugin's saved setup conversation; that helper skips
+        // an active model turn. A UI sync failure cannot undo a successful login.
+        try { await plugin.refreshOnboarding?.(); } catch {}
+      }
+      // Never project raw adapter messages, connection payloads or login inputs.
+      return { ...await snapshot(plugin), operation: { ok: result.ok === true, code: code(record(result.error).code) } };
+    },
+  };
+}
