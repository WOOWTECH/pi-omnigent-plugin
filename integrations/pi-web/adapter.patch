@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+const { AgentSessionWrapper } = await createJiti(import.meta.url).import("./rpc-manager.ts");
+
+function fixture(t, overrides = {}) {
+  const inner = {
+    sessionId: "own-onboarding", sessionFile: undefined, isStreaming: false, isCompacting: false, isBashRunning: false,
+    autoCompactionEnabled: true, autoRetryEnabled: true, model: undefined,
+    modelRuntime: { getModel: () => undefined, refresh: async () => {} },
+    sessionManager: { getCwd: () => process.cwd() }, settingsManager: { setProjectTrusted: () => {}, getDefaultTools: () => undefined },
+    agent: { state: {} }, extensionRunner: { getRegisteredCommands: () => [], setUIContext: () => {}, emit: async () => {} },
+    promptTemplates: [], resourceLoader: { getSkills: () => ({ skills: [] }) }, subscribe: () => () => {},
+    getContextUsage: () => null, getSteeringMessages: () => [], getFollowUpMessages: () => [],
+    getActiveToolNames: () => ["read", "bash"], getAllTools: () => [], setActiveToolsByName: () => {},
+    pendingMessageCount: 0, dispose: () => {}, abortBash: () => {}, reload: async () => {}, ...overrides,
+  };
+  const wrapper = new AgentSessionWrapper(inner), events = [];
+  wrapper.onEvent(event => events.push(event));
+  t.after(() => wrapper.destroy());
+  return { wrapper, events, ui: wrapper.createExtensionUiContext() };
+}
+
+test("targeted wizard refresh closes stale input and custom UI and accepts new dialogs", async t => {
+  const { wrapper, ui, events } = fixture(t);
+  const pendingInput = ui.input("Omnigent Server URL");
+  const oldId = events.find(e => e.method === "input").id;
+  let disposed = 0;
+  const pendingCustom = ui.custom(() => ({ render: () => ["•••"], handleInput() {}, dispose: () => { disposed++; } }));
+  await new Promise(resolve => setImmediate(resolve));
+  await wrapper.send({ type: "reload", clearExtensionUi: true });
+  assert.equal(await pendingInput, undefined);
+  assert.equal(await pendingCustom, undefined);
+  assert.equal(disposed, 1);
+  assert.ok(events.some(e => e.type === "extension_ui_closed" && e.id === oldId));
+  const replay = []; const stop = wrapper.onEvent(e => replay.push(e)); stop();
+  assert.equal(replay.some(e => e.type === "extension_ui_request"), false);
+  const next = ui.input("Fresh URL");
+  const nextId = events.filter(e => e.method === "input").at(-1).id;
+  await wrapper.send({ type: "extension_ui_response", id: nextId, value: "https://new.example" });
+  assert.equal(await next, "https://new.example");
+});
+
+test("ordinary reload retains its existing dialog behavior", async t => {
+  const { wrapper, ui, events } = fixture(t);
+  const pending = ui.input("Other plugin input"), id = events.at(-1).id;
+  await wrapper.send({ type: "reload" });
+  assert.equal(events.some(e => e.type === "extension_ui_closed" && e.id === id), false);
+  await wrapper.send({ type: "extension_ui_response", id, value: "retained" });
+  assert.equal(await pending, "retained");
+});
+
+test("targeted refresh rejects a turn that started after the caller checked running sessions", async t => {
+  for (const active of [{ isStreaming: true }, { isCompacting: true }, { isBashRunning: true }]) {
+    const { wrapper, ui, events } = fixture(t, active);
+    const pending = ui.input("Unchanged input"), id = events.at(-1).id;
+    await assert.rejects(wrapper.send({ type: "reload", clearExtensionUi: true }), /session is running/);
+    assert.equal(events.some(e => e.type === "extension_ui_closed" && e.id === id), false);
+    await wrapper.send({ type: "extension_ui_response", id, value: "preserved" });
+    assert.equal(await pending, "preserved");
+  }
+});
diff --git a/lib/omnigent-runtime.test.mjs b/lib/omnigent-runtime.test.mjs
